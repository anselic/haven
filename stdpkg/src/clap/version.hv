// CLAP ABI bindings — version.h
//
// Transcribed from the CLAP 1.2.x C headers. Every struct that crosses the ABI
// is `@repr(C)`; string IDs and flag values are `pub const` globals.
//
// See std/clap/plugin.hv for the entry point a `.clap` must export.

// typedef struct clap_version { uint32_t major, minor, revision; }
@repr(C)
pub struct ClapVersion { major: u32, minor: u32, revision: u32 }

// CLAP_VERSION — the version this binding targets (1.2.2).
pub proc clap_version_current() ClapVersion {
    return ClapVersion { major: 1u32, minor: 2u32, revision: 2u32 };
}

// clap_version_is_compatible: hosts and plugins built against CLAP >= 1.0.0 are
// ABI compatible, so anything with major == 1 is accepted.
pub proc clap_version_is_compatible(v: ClapVersion) bool {
    return v.major == 1u32;
}
