// CLAP ABI bindings — events.h
//
// The event header prefixes every event; `type`/`space_id` are uint16_t, note
// coordinates are int16_t — both representable now that haven has i16/u16.

// typedef struct clap_event_header {
//   uint32_t size, time; uint16_t space_id, type; uint32_t flags;
// }
@repr(C)
pub struct ClapEventHeader {
    size: u32,
    time: u32,
    space_id: u16,
    kind: u16,       // `type` in C — the event-type id (CLAP_EVENT_*)
    flags: u32,
}

// The core event space. An event's `space_id` must equal this to be a core
// (note/param/transport/midi) event.
pub const CLAP_CORE_EVENT_SPACE_ID: u16 = 0u16;

// clap_event_type
pub const CLAP_EVENT_NOTE_ON: u16 = 0u16;
pub const CLAP_EVENT_NOTE_OFF: u16 = 1u16;
pub const CLAP_EVENT_NOTE_CHOKE: u16 = 2u16;
pub const CLAP_EVENT_NOTE_END: u16 = 3u16;
pub const CLAP_EVENT_NOTE_EXPRESSION: u16 = 4u16;
pub const CLAP_EVENT_PARAM_VALUE: u16 = 5u16;
pub const CLAP_EVENT_PARAM_MOD: u16 = 6u16;
pub const CLAP_EVENT_PARAM_GESTURE_BEGIN: u16 = 7u16;
pub const CLAP_EVENT_PARAM_GESTURE_END: u16 = 8u16;
pub const CLAP_EVENT_TRANSPORT: u16 = 9u16;
pub const CLAP_EVENT_MIDI: u16 = 10u16;
pub const CLAP_EVENT_MIDI_SYSEX: u16 = 11u16;
pub const CLAP_EVENT_MIDI2: u16 = 12u16;

// clap_event_flags
pub const CLAP_EVENT_IS_LIVE: u32 = 1u32;     // 1 << 0
pub const CLAP_EVENT_DONT_RECORD: u32 = 2u32; // 1 << 1

// typedef struct clap_event_note — note on/off/choke/end.
@repr(C)
pub struct ClapEventNote {
    header: ClapEventHeader,
    note_id: i32,
    port_index: i16,
    channel: i16,
    key: i16,
    velocity: f64,
}

// typedef struct clap_event_param_value
@repr(C)
pub struct ClapEventParamValue {
    header: ClapEventHeader,
    param_id: u32,       // clap_id
    cookie: *void,
    note_id: i32,
    port_index: i16,
    channel: i16,
    key: i16,
    value: f64,
}

// typedef struct clap_event_param_mod
@repr(C)
pub struct ClapEventParamMod {
    header: ClapEventHeader,
    param_id: u32,
    cookie: *void,
    note_id: i32,
    port_index: i16,
    channel: i16,
    key: i16,
    amount: f64,
}

// typedef struct clap_event_transport — positions are int64 fixed-point
// (clap_beattime / clap_sectime).
@repr(C)
pub struct ClapEventTransport {
    header: ClapEventHeader,
    flags: u32,
    song_pos_beats: i64,
    song_pos_seconds: i64,
    tempo: f64,
    tempo_inc: f64,
    loop_start_beats: i64,
    loop_end_beats: i64,
    loop_start_seconds: i64,
    loop_end_seconds: i64,
    bar_start: i64,
    bar_number: i32,
    tsig_num: u16,
    tsig_denom: u16,
}

// clap_transport flags
pub const CLAP_TRANSPORT_HAS_TEMPO: u32 = 1u32;          // 1 << 0
pub const CLAP_TRANSPORT_HAS_BEATS_TIMELINE: u32 = 2u32; // 1 << 1
pub const CLAP_TRANSPORT_HAS_SECONDS_TIMELINE: u32 = 4u32;
pub const CLAP_TRANSPORT_HAS_TIME_SIGNATURE: u32 = 8u32;
pub const CLAP_TRANSPORT_IS_PLAYING: u32 = 16u32;        // 1 << 4
pub const CLAP_TRANSPORT_IS_RECORDING: u32 = 32u32;
pub const CLAP_TRANSPORT_IS_LOOP_ACTIVE: u32 = 64u32;
pub const CLAP_TRANSPORT_IS_WITHIN_PRE_ROLL: u32 = 128u32;

// clap_beattime / clap_sectime fixed-point factor (1 << 31).
pub const CLAP_BEATTIME_FACTOR: i64 = 2147483648i64;
pub const CLAP_SECTIME_FACTOR: i64 = 2147483648i64;

// typedef struct clap_input_events — the host's ordered input event queue.
@repr(C)
pub struct ClapInputEvents {
    ctx: *void,
    size: proc(*ClapInputEvents) u32,
    get: proc(*ClapInputEvents, u32) *ClapEventHeader,
}

// typedef struct clap_output_events — where a plugin pushes outgoing events.
@repr(C)
pub struct ClapOutputEvents {
    ctx: *void,
    try_push: proc(*ClapOutputEvents, *ClapEventHeader) bool,
}
