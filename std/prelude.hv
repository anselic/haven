/// std/prelude: the automatically imported module.
///
/// The prelude is imported implicitly into every module, so these items are in
/// scope everywhere without an `import`. It is deliberately tiny.
///
/// The `@!prelude` below is what says so. It is a *module* attribute - the `!`
/// marks it as a statement about this file rather than about the declaration
/// that follows it - and it is the whole reason this module is the prelude:
/// nothing keys off the name `prelude` or off where the file sits.
@!prelude

// backing symbols from crt/rt.c (always linked in). these are raw runtime
// plumbing, kept private; call the `pub` wrappers below instead.
extern strlen(s: str) u64;

// re-exports
pub import std/clone { Clone }
pub import std/fmt { Display }
import std/fmt { display_print, display_println }
pub import std/string { String }
pub import std/vec { Vec }

/// A destructor. Implement it to give a type ownership of a resource:
///
///     extend Buf: Delete {
///         proc delete(*self) { dealloc::<u8>(self.data, self.cap); }
///     }
///
/// This is a *lang item*: the `@lang(delete)` below is what tells the compiler
/// which trait this is, so implementing it is a statement about ownership and
/// not merely a conformance. The mark is the whole identification - the name and
/// the module are ordinary, so your own `trait Delete` is an ordinary trait.
///
///   * the type stops being `Copy`, and so does anything holding one, so
///     assigning or passing it by value **moves** it and the source can no
///     longer be used. That is what turns a silent aliasing bug into an error;
///   * the compiler calls `delete` for you when an owner goes out of scope, is
///     overwritten, or is dropped at a `return` - once, on the live owner, and
///     never on one whose value has been moved away.
///
/// Never call `delete` by hand: the automatic call still happens, and the
/// resource would be released twice.
@lang(delete)
pub trait Delete {
    proc delete(*self);
}

extern rt_puts(s: str) void;

extern rt_slice_len<T>(slice: *[T]) u64;
extern rt_slice_from_raw_parts<T>(ptr: *T, len: u64) *[T];

// The runtime target of `abort`, defined in rt.c. It returns `!`: control never
// comes back, so a call to it (or to `abort`) diverges - the compiler emits it as
// a void call followed by `unreachable`.
extern rt_abort(msg: str) !;

/// Print `msg` and terminate the process. Its result type is the bottom type `!`,
/// so it coerces to any expected type - `return abort("...")` type-checks in a
/// function of any return type, and a bare `abort("...")` ends a `match` arm
/// without a value.
pub proc abort(msg: str) ! { rt_abort(msg); }

/// Write `s` to stdout with no trailing newline.
pub proc print<T: Display>(x: T) void {
    rt_puts(x.display().as_str());
}
/// Write `s` to stdout followed by a newline.
pub proc println<T: Display>(x: T) void {
    print(x); print("\n");
}

/// The number of elements in the runtime slice `slice`.
pub proc slice_len<T>(slice: *[T]) u64 { return rt_slice_len::<T>(slice); }
