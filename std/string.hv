/// std/string: an owned, growable text buffer.
///
/// `String` is a heap-backed, growable string, a thin wrapper over a `Vec<u8>`
/// of bytes exactly as Rust's `String` wraps a `Vec<u8>`. Build one with
/// `String::new` (or `String::from_str` to seed it from a literal), append with
/// `s.push_byte`/`s.push_str`, compare with `s.eq`, and hand a borrowable C
/// string to `print`/`printf` via `s.as_str`.
///
/// A `String` owns its heap allocation and frees it for you: it holds a `Vec<u8>`
/// field, and `Vec` implements `Delete`, so a String is destroyed - buffer freed
/// - when it goes out of scope, with no manual free to call. A fresh `String::new`
/// allocates nothing, so an empty String is cheap and the first push performs the
/// initial allocation. No UTF-8 validation is done: `s.push_byte` can build
/// ill-formed sequences, so treat the contents as raw bytes unless you know they
/// are valid text.

// All the growth/allocation machinery is inherited from `Vec<u8>` (see std/vec);
// this module only adds string-flavored operations, built entirely on Vec's
// public API. Bytes are stored WITHOUT a trailing NUL - `len` is the exact byte
// count - and the NUL a C `str` needs is written on demand by `as_str`.
//
// destruction is inherited too: a `String` owns nothing of its own beyond the
// `buf: Vec<u8>` field, so the compiler drops it by dropping `buf`, whose own
// `Delete` frees the bytes. No `String`-level `Delete` impl is needed or wanted.
// `str` is haven's own type (not a `*u8`), so it cannot be indexed or `ptr_cast`;
// the two runtime shims below reinterpret between a `str` and its raw bytes (a
// no-op at the machine level, both are a bare pointer), and libc `strlen`
// recovers a `str`'s length.

import std/vec { Vec }

extern strlen(s: str) u64;
extern rt_str_as_bytes(s: str) *u8;
extern rt_bytes_as_str(p: *u8) str;

pub struct String {
    buf: Vec<u8>,  /// the raw bytes, without a trailing NUL

    /// An empty String that owns no allocation yet.
    proc new() String {
        return String { buf: Vec::<u8>::new() };
    }

    /// An empty String with room for `cap` bytes already reserved.
    proc with_capacity(cap: u64) String {
        return String { buf: Vec::<u8>::with_capacity(cap) };
    }

    /// A String seeded with a copy of the bytes of the `str` `text`.
    proc from_str(text: str) String {
        let s: String = String::new();
        s.push_str(text);
        return s;
    }

    /// The number of bytes in the String (not counting any scratch NUL).
    proc len(*self) u64 { return self.buf.len(); }
    /// The number of bytes the buffer can hold before it must grow.
    proc cap(*self) u64 { return self.buf.cap(); }
    /// Whether the String holds no bytes.
    proc is_empty(*self) bool { return self.buf.is_empty(); }

    /// Append a single raw byte, growing the buffer if it is full. No UTF-8
    /// checking is done.
    proc push_byte(*self, b: u8) {
        self.buf.push(b);
    }

    /// Append a copy of the bytes of the `str` `text`.
    proc push_str(*self, text: str) {
        let n: u64 = strlen(text);
        let src: *u8 = rt_str_as_bytes(text);
        // one reserve up front, then fill - avoids re-checking capacity per byte.
        self.buf.reserve(self.len() + n);
        let i: u64 = 0u64;
        while (i < n) {
            self.buf.push(src[i]);
            i = i + 1u64;
        }
    }

    /// Logically empty the String without shrinking its buffer. The bytes own
    /// nothing, so this just resets the length.
    proc clear(*self) { self.buf.clear(); }

    /// Whether this String and `other` hold exactly the same bytes.
    proc eq(*self, other: *String) bool {
        if (self.len() != other.len()) { return false; }
        let n: u64 = self.len();
        let i: u64 = 0u64;
        while (i < n) {
            if (self.buf.get(i) != other.buf.get(i)) { return false; }
            i = i + 1u64;
        }
        return true;
    }

    /// A borrowable, NUL-terminated `str` view of the bytes, valid until the next
    /// mutation or free. Writes a scratch NUL one past the last byte (growing the
    /// buffer if needed) without changing the logical length, so the returned
    /// `str` stops exactly where the String's bytes do.
    proc as_str(*self) str {
        self.buf.reserve(self.len() + 1u64);
        self.buf.set(self.len(), 0u8);
        return rt_bytes_as_str(self.buf.get_ptr(0u64));
    }
}
