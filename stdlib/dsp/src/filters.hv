/// dsp/filters: audio filters.
///
/// Three drop-in filter types, from cheapest to most capable: a one-pole
/// lowpass, a general-purpose biquad with the standard RBJ EQ responses
/// (lowpass, highpass, bandpass, notch, peaking, shelves), and a
/// state-variable filter that produces lowpass/highpass/bandpass/notch at once.
///
/// The usage pattern is the same for all three: build one with a constructor
/// (`cutoff`/`q`/`sr` in hertz), then call its `.process` method once per input
/// sample. State lives in the filter struct, so keep it between samples.
/// All single precision.

import std/math { expf, cosf, sinf, tanf, sqrtf, powf, pi_f32, tau_f32 }

// --- OnePole --------------------------------------------------------------

/// A one-pole lowpass, the cheapest usable smoother, one multiply-add per
/// sample. Good for de-zippering control signals and gentle tone shaping.
// difference equation y = a0*x + b1*y[-1]; b1 = exp(-2*pi*fc/sr) places the
// pole and a0 = 1 - b1 keeps unity gain at DC.
pub struct OnePole {
    a0: f32,
    b1: f32,
    z1: f32, // previous output

    /// A one-pole lowpass with corner frequency `cutoff` hertz at sample rate `sr`.
    pub proc lowpass(cutoff: f32, sr: f32) OnePole {
        let b1: f32 = expf(-tau_f32() * cutoff / sr);
        return OnePole { a0: 1.0 - b1, b1: b1, z1: 0.0 };
    }

    /// Retune to corner frequency `cutoff` at sample rate `sr`.
    pub proc set_cutoff(*self, cutoff: f32, sr: f32) {
        self.b1 = expf(-tau_f32() * cutoff / sr);
        self.a0 = 1.0 - self.b1;
    }

    /// Filter one input sample `x`, returning the filtered output.
    @alloc(false)
    pub proc process(*self, x: f32) f32 {
        self.z1 = self.a0 * x + self.b1 * self.z1;
        return self.z1;
    }
}

// --- Biquad ---------------------------------------------------------------

/// A second-order (biquad) section covering the common EQ responses via the
/// constructors below. The workhorse building block of parametric EQs and
/// crossovers; chain several for steeper slopes.
// transposed direct-form II. coefficients use the RBJ audio-EQ cookbook and are
// stored a0-normalized (biquad_from does the normalization and clears state).
pub struct Biquad {
    b0: f32, b1: f32, b2: f32,
    a1: f32, a2: f32,
    s1: f32, s2: f32, // transposed DF-II state

    /// Build a biquad from raw coefficients `b0..a2`, normalizing by `a0` and
    /// starting from zero state. The response constructors below are built on this.
    pub proc from(b0: f32, b1: f32, b2: f32, a0: f32, a1: f32, a2: f32) Biquad {
        return Biquad {
            b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
            a1: a1 / a0, a2: a2 / a0,
            s1: 0.0, s2: 0.0,
        };
    }

    /// Lowpass at `cutoff` hertz with resonance `q`, for sample rate `sr`.
    pub proc lowpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            (1.0 - cs) / 2.0, 1.0 - cs, (1.0 - cs) / 2.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Highpass at `cutoff` hertz with resonance `q`, for sample rate `sr`.
    pub proc highpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            (1.0 + cs) / 2.0, -(1.0 + cs), (1.0 + cs) / 2.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Bandpass centered at `cutoff` hertz with `q` setting the width, normalized
    /// to 0 dB peak gain, for sample rate `sr`.
    pub proc bandpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            alpha, 0.0, -alpha,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Notch (band-reject) at `cutoff` hertz with `q` setting the width, for
    /// sample rate `sr`.
    pub proc notch(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            1.0, -2.0 * cs, 1.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Peaking EQ: `gain_db` boost (or cut) at `cutoff` hertz, bandwidth set by
    /// `q`, for sample rate `sr`.
    pub proc peak(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            1.0 + alpha * a, -2.0 * cs, 1.0 - alpha * a,
            1.0 + alpha / a, -2.0 * cs, 1.0 - alpha / a);
    }

    /// Low shelf: `gain_db` boost (or cut) below `cutoff` hertz, slope set by
    /// `q`, for sample rate `sr`.
    pub proc lowshelf(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        let ta: f32 = 2.0 * sqrtf(a) * alpha;
        return Biquad::from(
            a * ((a + 1.0) - (a - 1.0) * cs + ta),
            2.0 * a * ((a - 1.0) - (a + 1.0) * cs),
            a * ((a + 1.0) - (a - 1.0) * cs - ta),
            (a + 1.0) + (a - 1.0) * cs + ta,
            -2.0 * ((a - 1.0) + (a + 1.0) * cs),
            (a + 1.0) + (a - 1.0) * cs - ta);
    }

    /// High shelf: `gain_db` boost (or cut) above `cutoff` hertz, slope set by
    /// `q`, for sample rate `sr`.
    pub proc highshelf(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        let ta: f32 = 2.0 * sqrtf(a) * alpha;
        return Biquad::from(
            a * ((a + 1.0) + (a - 1.0) * cs + ta),
            -2.0 * a * ((a - 1.0) + (a + 1.0) * cs),
            a * ((a + 1.0) + (a - 1.0) * cs - ta),
            (a + 1.0) - (a - 1.0) * cs + ta,
            2.0 * ((a - 1.0) - (a + 1.0) * cs),
            (a + 1.0) - (a - 1.0) * cs - ta);
    }

    /// Retune to `other`'s response, keeping the running state, so a filter can
    /// be moved mid-stream without the discontinuity a fresh one would produce:
    ///
    ///     f.set(Biquad::lowpass(cutoff, q, sr));
    pub proc set(*self, other: Biquad) {
        self.b0 = other.b0;
        self.b1 = other.b1;
        self.b2 = other.b2;
        self.a1 = other.a1;
        self.a2 = other.a2;
    }

    /// Filter one input sample `x`, returning the filtered output.
    @alloc(false)
    pub proc process(*self, x: f32) f32 {
        let y: f32 = self.b0 * x + self.s1;
        self.s1 = self.b1 * x - self.a1 * y + self.s2;
        self.s2 = self.b2 * x - self.a2 * y;
        return y;
    }
}

// --- StateVariable --------------------------------------------------------

/// The four simultaneous outputs of a state-variable filter for one sample.
pub struct SvfOut {
    lp: f32,    /// lowpass output
    hp: f32,    /// highpass output
    bp: f32,    /// bandpass output
    notch: f32, /// notch (lowpass + highpass) output
}

/// A state-variable filter producing lowpass, highpass, bandpass and notch from
/// a single pass, sweep-friendly, so it's the one to reach for when the cutoff
/// is being modulated.
// topology-preserving-transform (Zavalishin) design. stays well-behaved when the
// cutoff is modulated near Nyquist, unlike the classic Chamberlin SVF.
pub struct StateVariable {
    g: f32, // tan(pi * fc / sr)
    k: f32, // damping, = 1 / Q
    a1: f32, a2: f32, a3: f32,
    ic1eq: f32, ic2eq: f32, // integrator states

    /// A state-variable filter at `cutoff` hertz with resonance `q`, for sample
    /// rate `sr`.
    pub proc new(cutoff: f32, q: f32, sr: f32) StateVariable {
        let g: f32 = tanf(pi_f32() * cutoff / sr);
        let k: f32 = 1.0 / q;
        let a1: f32 = 1.0 / (1.0 + g * (g + k));
        let a2: f32 = g * a1;
        let a3: f32 = g * a2;
        return StateVariable { g: g, k: k, a1: a1, a2: a2, a3: a3, ic1eq: 0.0, ic2eq: 0.0 };
    }

    /// Retune to `cutoff` hertz and resonance `q`, for sample rate `sr`, keeping
    /// its running state.
    pub proc set(*self, cutoff: f32, q: f32, sr: f32) {
        self.g = tanf(pi_f32() * cutoff / sr);
        self.k = 1.0 / q;
        self.a1 = 1.0 / (1.0 + self.g * (self.g + self.k));
        self.a2 = self.g * self.a1;
        self.a3 = self.g * self.a2;
    }

    /// Filter one input sample `x`, returning all four responses as an `SvfOut`.
    @alloc(false)
    pub proc process(*self, x: f32) SvfOut {
        let v3: f32 = x - self.ic2eq;
        let v1: f32 = self.a1 * self.ic1eq + self.a2 * v3;
        let v2: f32 = self.ic2eq + self.a2 * self.ic1eq + self.a3 * v3;
        self.ic1eq = 2.0 * v1 - self.ic1eq;
        self.ic2eq = 2.0 * v2 - self.ic2eq;

        let lp: f32 = v2;
        let bp: f32 = v1;
        let hp: f32 = x - self.k * v1 - v2;
        return SvfOut { lp: lp, hp: hp, bp: bp, notch: hp + lp };
    }
}
