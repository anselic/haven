/// std/denormal: process a block with denormals flushed to zero.
///
/// A denormal (subnormal) float is the hardware's slow path. Audio that decays
/// towards silence - a filter ringing out, a reverb tail, a delay feedback loop
/// - eventually consists of nothing else, so the *quietest* block is the one
/// that overruns its deadline. The fix is not in the arithmetic but in the FPU:
/// ask it to flush denormals to zero and the same block runs at full speed, with
/// an error far below the noise floor of any converter.
///
/// The setting is per-thread and belongs to whoever owns the thread, so it is
/// saved and restored rather than set once. A plugin runs on the host's audio
/// thread and must hand it back unchanged; the `plug` framework already wraps every
/// `process` call this way, so a plugin written against that framework needs
/// nothing from this module. Reach for it when you own an audio callback
/// directly:
///
///     let saved: u64 = denormals_disable();
///     run_my_dsp(block);
///     denormals_restore(saved);
///
/// Or let scope do it, which is the same thing without the chance of forgetting
/// the second line on an early return:
///
///     proc callback(block: *[f32]) void {
///         let _ftz: Ftz = Ftz::new();   // restored when `_ftz` is dropped
///         run_my_dsp(block);
///     }

// backing symbols from dsp/c/denormal.c, which is where the per-architecture
// control word (x86 MXCSR, aarch64 FPCR) is actually poked.
extern rt_denormals_disable() u64;
extern rt_denormals_restore(saved: u64) void;

/// Flush denormals to zero from here on, returning the previous FPU control
/// word. Pass that value to `denormals_restore` when the block is done - the
/// mode is shared with the rest of the thread and is not ours to keep.
///
/// A no-op returning `0` on targets with no such control.
pub proc denormals_disable() u64 { return rt_denormals_disable(); }

/// Put back a control word returned by `denormals_disable`.
pub proc denormals_restore(saved: u64) void { rt_denormals_restore(saved); }

/// The scoped form: flush-to-zero for as long as this value is alive.
///
/// Constructing one disables denormals and remembers the previous mode;
/// dropping one puts that mode back. Because the restore is a destructor it
/// also runs on an early `return`, which is the case hand-written save/restore
/// pairs tend to miss.
pub struct Ftz {
    saved: u64,
}

extend Ftz {
    /// Disable denormals until the returned value is dropped.
    pub proc new() Self { return Self { saved: rt_denormals_disable() }; }
}

extend Ftz: Delete {
    proc delete(*self) { rt_denormals_restore(self.saved); }
}
