/// std/result: a value or an error, backed by a real (data-carrying) enum.
///
/// `Result<T, E>` holds either a success value (`Ok(T)`) or an error (`Err(E)`),
/// for any `T` and `E`. It is the idiom for a fallible operation that wants to
/// say *why* it failed - where `Option<T>` only says *that* it did. Test it with
/// `is_ok`/`is_err` (which borrow), then take a value out with `unwrap`/`expect`/
/// `unwrap_or`/`unwrap_err` (which consume the `Result`), or transform it with
/// `map`/`map_err`/`and_then`.
///
/// Taking a value out is a by-value move: the contained value is handed to the
/// caller and the `Result` is spent. `unwrap`/`expect` have nothing to return on
/// `Err` (and `unwrap_err` nothing on `Ok`), so they `abort` - guard with
/// `is_ok`/`is_err` (or use `unwrap_or`) when the wrong variant is possible.

pub enum Result<T, E> {
    Ok(T),
    Err(E),

    /// Whether the `Result` is `Ok`. Borrows, so the `Result` is untouched.
    pub proc is_ok(*self) bool {
        match (*self) {
            Result::Ok(_)  -> { return true; }
            Result::Err(_) -> { return false; }
        }
    }

    /// Whether the `Result` is `Err`. Borrows, so the `Result` is untouched.
    pub proc is_err(*self) bool {
        return !self.is_ok();
    }

    /// The success value, consuming the `Result`. Aborts if it is `Err`, so only
    /// call it where `Err` is impossible (or guard with `is_ok` first).
    pub proc unwrap(self) T {
        match (self) {
            Result::Ok(v)  -> { return v; }
            Result::Err(_) -> { abort("called `unwrap` on an `Err` value"); }
        }
    }

    /// The success value, consuming the `Result`. Aborts with `msg` if it is
    /// `Err` - like `unwrap`, but with a message that says what was expected.
    pub proc expect(self, msg: str) T {
        match (self) {
            Result::Ok(v)  -> { return v; }
            Result::Err(_) -> { abort(msg); }
        }
    }

    /// The error value, consuming the `Result`. Aborts if it is `Ok`. The mirror
    /// of `unwrap`, for when you expect the failure.
    pub proc unwrap_err(self) E {
        match (self) {
            Result::Ok(_)  -> { abort("called `unwrap_err` on an `Ok` value"); }
            Result::Err(e) -> { return e; }
        }
    }

    /// The success value, or `default` when the `Result` is `Err`. Consumes the
    /// `Result` and, on the `Ok` path, destroys the unused `default`.
    pub proc unwrap_or(self, default: T) T {
        match (self) {
            Result::Ok(v)  -> { return v; }
            Result::Err(_) -> { return default; }
        }
    }

    /// Map `Ok(v)` to `Ok(f(v))` and leave `Err` untouched, consuming the
    /// `Result` and moving the value into `f`. `U` is the method's own parameter
    /// (the receiver fixes `T` and `E`), so write it as a turbofish: `r.map::<U>(f)`.
    pub proc map<U>(self, f: proc(T) U) Result<U, E> {
        match (self) {
            Result::Ok(v)  -> { return Result::Ok::<U, E>(f(v)); }
            Result::Err(e) -> { return Result::Err::<U, E>(e); }
        }
    }

    /// Map `Err(e)` to `Err(f(e))` and leave `Ok` untouched. The error-side twin
    /// of `map`; written with a turbofish for the new error type: `r.map_err::<F>(f)`.
    pub proc map_err<F>(self, f: proc(E) F) Result<T, F> {
        match (self) {
            Result::Ok(v)  -> { return Result::Ok::<T, F>(v); }
            Result::Err(e) -> { return Result::Err::<T, F>(f(e)); }
        }
    }

    /// Chain another fallible step: `Ok(v)` becomes `f(v)` (itself a `Result`) and
    /// `Err` stays `Err`. Consumes the `Result` and moves the value into `f`.
    /// Written with a turbofish like `map`: `r.and_then::<U>(f)`.
    pub proc and_then<U>(self, f: proc(T) Result<U, E>) Result<U, E> {
        match (self) {
            Result::Ok(v)  -> { return f(v); }
            Result::Err(e) -> { return Result::Err::<U, E>(e); }
        }
    }
}

/// The unit type: a single value carrying no information, for a `Result` whose
/// success case has nothing to hand back (`Result<Unit, E>`, as `fs::mkdir`
/// returns). It is the stand-in for `()`.
pub enum Unit { Unit }
