//! Core types, memory management, I/O, and other facilities available to every Haven program.
//!
//! The haven's standard library (`std`) is a package of modules that every program
//! can use. It provides core types, memory management, I/O, and other facilities.
//! The `std` package is always available on every packages and modules by default.
//!
//! You can use the search button to find the documentation for any type or function
//! in the standard library, and then import it using `import` statements in your code.
//!
//! ```hv
//! import std/env { env }
//!
//! let args: Vec<str> = env::args();
//! ```

@!prelude

// what every module in every program using this package sees without an import.
pub import clone { Clone }
pub import fmt { Display, print, println }
pub import string { String }
pub import vec { Vec }
pub import result { Result, Unit }
pub import option { Option }
pub import iter { IntoIterator, Iterator } // needed for `for` loops

import fmt { display_print, display_println }

// everything else std provides, available via `import std/...` in user code.

import alloc
import atomic
import bits
import env
import ffi
import fs
import iter
import math
import mem
import option
import process
import rand
import result
import ring
import simd
import spsc

/// A destructor. Implement it to give a type ownership of a resource:
/// ```hv
/// extend Buf: Delete {
///     proc delete(*self) { dealloc::<u8>(self.data, self.cap); }
/// }
/// ```
/// `Delete` is a lang item. Implementing it makes the type non-`Copy`; passing
/// the value transfers ownership. The compiler calls `delete` for each live
/// owner at scope exit, before overwrite, and on return.
///
/// Never call `delete` directly, or the automatic call will release it twice.
@lang(delete)
pub trait Delete {
    proc delete(*self);
}

// backing symbols from std/c/rt.c (always linked in)
extern strlen(s: str) u64;

extern rt_abort(msg: str) ! without [Alloc];
extern rt_slice_len<T>(slice: *[T]) u64 without [Alloc];
extern rt_slice_slice<T>(slice: *[T], start: u64, end: u64, elem_sz: u64) without [Alloc];

/// Print `msg` and terminate the process. Its result type is the bottom type `!`,
/// so it coerces to any expected type - `return abort("...")` type-checks in a
/// function of any return type, and a bare `abort("...")` ends a `match` arm
/// without a value.
pub proc abort(msg: str) ! without [Alloc] { rt_abort(msg); }

/// The number of elements in the runtime slice `slice`.
@noalias
pub proc slice_len<T>(slice: *[T]) u64 without [Alloc] { return rt_slice_len::<T>(slice); }

/// The runtime slice `slice` is sliced to the range `[start, end)`, and the new length is returned.
/// panics: `start > end` or `end > slice length`
// TODO: think of a better name
pub proc slice_slice<T>(slice: *[T], start: u64, end: u64) [T] without [Alloc] {
    let new_slice = slice.clone();
    rt_slice_slice::<T>(&new_slice, start, end, sizeof::<T>());
    return new_slice;
}
