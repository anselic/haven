@!prelude

// The prelude proper: what every module in every program using this package
// sees without an import.
pub import clone { Clone }
pub import fmt { Display }
pub import string { String }
pub import vec { Vec }
pub import result { Result, Unit }
pub import option { Option }

import fmt { display_print, display_println }

// Everything else the package ships, pulled in so that it *exists*. A `.hvmeta`
// carries the modules that were loaded, and loading starts here - so a module
// this root cannot reach is not merely unused, it is absent from the artifact
// and no consumer can import it. These bind a module-private qualifier and
// export nothing, so nothing here reaches a consumer's scope.
import alloc
import atomic
import bits
import env
import fs
import iter
import math
import mem
import option
import process
import rand
import result
import ring
import simd
import spsc

/// A destructor. Implement it to give a type ownership of a resource:
///
///     extend Buf: Delete {
///         proc delete(*self) { dealloc::<u8>(self.data, self.cap); }
///     }
///
/// `Delete` is a lang item. Implementing it makes the type non-`Copy`; passing
/// the value transfers ownership. The compiler calls `delete` for each live
/// owner at scope exit, before overwrite, and on return.
///
/// Never call `delete` directly, or the automatic call will release it twice.
@lang(delete)
pub trait Delete {
    proc delete(*self);
}

// backing symbols from std/c/rt.c (always linked in)
extern strlen(s: str) u64;
extern rt_puts(s: str) void;

@alloc(false) extern rt_abort(msg: str) !;
@alloc(false) extern rt_slice_len<T>(slice: *[T]) u64;
extern rt_slice_from_raw_parts<T>(ptr: *T, len: u64) *[T];

/// Print `msg` and terminate the process. Its result type is the bottom type `!`,
/// so it coerces to any expected type - `return abort("...")` type-checks in a
/// function of any return type, and a bare `abort("...")` ends a `match` arm
/// without a value.
@alloc(false)
pub proc abort(msg: str) ! { rt_abort(msg); }

/// Write `s` to stdout with no trailing newline.
pub proc print<T: Display>(x: T) void {
    rt_puts(x.display().as_str());
}
/// Write `s` to stdout followed by a newline.
pub proc println<T: Display>(x: T) void {
    print(x); print("\n");
}

/// The number of elements in the runtime slice `slice`.
@alloc(false)
pub proc slice_len<T>(slice: *[T]) u64 { return rt_slice_len::<T>(slice); }
