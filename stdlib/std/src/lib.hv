//! Allocation, I/O, and other facilities available to ordinary Haven programs.
//!
//! `std` depends on `core` and re-exports its foundational APIs.
//!
//! You can use the search button to find the documentation for any type or function
//! in the standard library, and then import it using `import` statements in your code.
//!
//! ```hv
//! import std/env { env }
//!
//! let args: Vec<str> = env::args();
//! ```

@!prelude

// what every module in every program using this package sees without an import.
pub import core/clone { Clone }
pub import fmt { Display, print, println }
pub import string { String }
pub import vec { Vec }
pub import core { Delete, abort, slice_len, slice_slice }
pub import core/result { Result, Unit }
pub import core/option { Option }
pub import core/iter { IntoIterator, Iterator } // needed for `for` loops

pub import core/option
pub import core/clone
pub import core/result
pub import core/iter
pub import core/math
pub import core/mem
pub import core/simd
pub import core/ffi

import fmt { display_print, display_println }

// everything else std provides, available via `import std/...` in user code.
import numeric

import alloc
import atomic
import env
import fs
import process
import rand
import ring
import spsc
