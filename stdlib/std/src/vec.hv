/// std/vec: a growable, heap-backed array.
///
/// `Vec<T>` is a dynamic array: push elements and it grows its backing buffer
/// for you, in amortized O(1) per push. Create one with `Vec::<T>::new` (or
/// `Vec::<T>::with_capacity` to pre-size), append with `v.push`, read with
/// `v.get`/`v.get_ptr`, and walk it with `v.for_each`/`v.map` or a `for` loop
/// over `v.iter()`.
///
/// A `Vec` owns its heap allocation and frees it for you: it implements `Delete`,
/// so the buffer is released when the Vec goes out of scope, and each element is
/// destroyed first (a no-op for elements that own nothing). There is no manual
/// free to call. A fresh `Vec::<T>::new` allocates nothing, so an empty Vec is
/// cheap and the first push performs the initial allocation.

// layout is a three-word triple (data/len/cap). growth doubles `cap` via
// `realloc` once `len` would exceed it, so N pushes cost O(N) total. because
// rt_realloc(null, n) behaves like malloc(n), a null `data` makes the first
// reserve a plain allocation with no special-casing.
//
// element ownership: `push`/`set` initialize a slot with `ptr_write`
// rather than `*p = value`, because the slot is fresh (or being overwritten in
// place, which the ownership pass forbids for an owning `T`). Destruction goes
// the other way: the `Delete` impl runs `drop_in_place` over the live prefix,
// which the ownership pass expands into one `T::delete` per element - and into
// nothing when `T` owns nothing, so a `Vec<i32>` pays for none of this.

import alloc { alloc, realloc, dealloc }
import option { Option }
import iter { Iterator }

pub struct Vec<T> {
    data: *T,  /// heap buffer, or null when cap == 0
    len: u64,  /// number of initialized elements
    cap: u64,  /// number of elements the buffer can hold

    /// An empty Vec that owns no allocation yet.
    pub proc new() Vec<T> {
        return Vec::<T> { data: null::<*T>(), len: 0u64, cap: 0u64 };
    }

    /// An empty Vec with room for `cap` elements already reserved.
    pub proc with_capacity(cap: u64) Vec<T> {
        let v: Vec<T> = Vec::<T>::new();
        v.reserve(cap);
        return v;
    }

    /// Create a Vec from a slice, copying the elements into a new buffer.
    pub proc from_slice(src: [T]) Vec<T> {
        let n: u64 = slice_len::<T>(&src);
        let v: Vec<T> = Vec::<T>::with_capacity(n);
        let i: u64 = 0u64;
        while (i < n) {
            v.push(src[i]);
            i = i + 1u64;
        }
        return v;
    }

    /// Adopt an existing heap buffer as a Vec, taking ownership of it. `data`
    /// must have been produced by the same allocator std/alloc uses (`rt_alloc`/
    /// libc `malloc`, which is what backs runtime buffers like `fs::read`'s),
    /// hold `len` initialized elements, and have room for `cap` of them. The Vec
    /// frees `data` via `dealloc` on drop, so it must not be freed elsewhere.
    pub proc from_raw_parts(data: *T, len: u64, cap: u64) Vec<T> {
        return Vec::<T> { data: data, len: len, cap: cap };
    }

    pub proc len(*self) u64 { return self.len; }
    pub proc cap(*self) u64 { return self.cap; }
    pub proc is_empty(*self) bool { return self.len == 0u64; }

    /// Ensure the buffer can hold at least `needed` elements, reallocating (and
    /// doubling) if it currently cannot. Does nothing when there is already room.
    pub proc reserve(*self, needed: u64) {
        if (self.cap < needed) {
            let new_cap: u64 = self.cap;
            if (new_cap == 0u64) { new_cap = 4u64; }
            while (new_cap < needed) { new_cap = new_cap * 2u64; }
            // realloc copies the old elements over; a null `data` makes this a malloc.
            self.data = realloc::<T>(self.data, new_cap).unwrap();
            self.cap = new_cap;
        }
    }

    /// Append `value` to the end, growing the buffer if it is full. `value` is
    /// moved into the Vec (for an owning `T`, the caller's copy is consumed).
    pub proc push(*self, value: T) {
        self.reserve(self.len + 1u64);
        // the slot is fresh capacity, uninitialized, so this initializes it rather
        // than overwriting a live value - which is exactly what `ptr_write` is for.
        ptr_write::<T>(&self.data[self.len], value);
        self.len = self.len + 1u64;
    }

    /// Read the element at `i` by value, or `none` when `i` is out of bounds.
    /// This copies the element out, so it is for a `Copy` `T` (an integer, a
    /// plain struct); for an owning `T` it would duplicate ownership, and
    /// instantiating it is a move error - reach the element by pointer with
    /// `get_ptr` instead.
    pub proc get(*self, i: u64) Option<T> {
        if (i >= self.len) {
            return Option::None::<T>();
        }
        return Option::Some::<T>(self.data[i]);
    }

    /// A pointer to the element at `i`, for in-place mutation of the slot, or
    /// `none` when `i` is out of bounds.
    pub proc get_ptr(*self, i: u64) Option<*T> {
        if (i >= self.len) {
            return Option::None::<*T>();
        }
        return Option::Some::<*T>(&self.data[i]);
    }

    /// The raw base pointer of the buffer (element 0), or null when the Vec has
    /// never allocated. Unlike `get_ptr`, this is not bounds-checked and does not
    /// depend on `len`: it hands back the buffer's address for callers that need
    /// to walk the raw bytes (an FFI `argv`, a byte view). Invalidated by the next
    /// push or free.
    pub proc as_ptr(*self) *T {
        return self.data;
    }

    /// Write `value` into the slot at `i`, without destroying whatever was there.
    /// Out-of-bounds is undefined; guard with len. Because it does not drop the
    /// previous occupant, this is for a `Copy` `T` or a slot known to be
    /// uninitialized; overwriting a live owning value with it would leak that value.
    pub proc set(*self, i: u64, value: T) {
        ptr_write::<T>(&self.data[i], value);
    }

    /// Remove and return the last element. Returns `Option<*T>`: `some` pointing
    /// at the (now logically dead but still resident) slot, or `none` when empty.
    /// The pointer is valid until the next push or free.
    pub proc pop(*self) Option<*T> {
        if (self.len == 0u64) {
            return Option::None::<*T>();
        }
        self.len = self.len - 1u64;
        return Option::Some::<*T>(&self.data[self.len]);
    }

    /// Empty the Vec, destroying its elements but keeping the buffer and capacity.
    /// For an owning `T` each element's `delete` runs; for a `Copy` `T` this just
    /// resets the length.
    pub proc clear(*self) {
        drop_in_place::<T>(self.data, self.len);
        self.len = 0u64;
    }

    /// Iterate over the Vec, calling `f` on each element by pointer.
    pub proc for_each(*self, f: proc(*T) void) {
        let i: u64 = 0u64;
        while (i < self.len) {
            f(self.get_ptr(i).unwrap());
            i = i + 1u64;
        }
    }

    /// Map each element to a new Vec by calling `f` on each element by pointer.
    /// `U` is the method's own parameter (the receiver only fixes `T`), so it is
    /// written as a turbofish at the call: `v.map::<U>(f)`.
    pub proc map<U>(*self, f: proc(*T) U) Vec<U> {
        let result: Vec<U> = Vec::<U>::with_capacity(self.len);
        let i: u64 = 0u64;
        while (i < self.len) {
            let value: U = f(self.get_ptr(i).unwrap());
            result.push(value);
            i = i + 1u64;
        }
        return result;
    }

    /// A by-pointer iterator over the elements, front to back, for driving a
    /// `for` loop. Like `for_each`, each element is yielded as a `*T` rather than
    /// by value, so an owning `T` is borrowed in place and never moved out of the
    /// Vec. Drive it directly: `for (p in v.iter()) { ... *p ... }`. The iterator
    /// holds a pointer back to this Vec and re-reads its length every step, so it must
    /// not outlive the Vec, and pushing during iteration (which may reallocate the
    /// buffer) still reads live elements but visits any newly pushed ones too.
    pub proc iter(*self) VecIter<T> {
        return VecIter::<T> { vec: self, pos: 0u64 };
    }
}

/// The iterator returned by `Vec::iter`: a pointer back to the source Vec and a
/// cursor. It reaches each element through `Vec::get_ptr` and re-reads the Vec's
/// length every step, so it always reflects the Vec's current state rather than a
/// snapshot taken when `iter` was called. It borrows the Vec and must not outlive
/// it.
pub struct VecIter<T> {
    vec: *Vec<T>,  /// the Vec being walked
    pos: u64,      /// index of the next element to yield
}

extend VecIter<T>: Iterator {
    type Item = *T;
    proc next(*self) Option<*T> {
        if (self.pos >= self.vec.len()) {
            return Option::None::<*T>();
        }
        let p: *T = self.vec.get_ptr(self.pos).unwrap();
        self.pos = self.pos + 1u64;
        return Option::Some::<*T>(p);
    }
}

// `Vec<T>` is `Clone` exactly when its elements are. Each element is cloned
// through a borrow (`get_ptr` gives a `*T`, and `clone` takes `*self`), so an
// owning element is duplicated, never moved out of the source Vec. There is no
// `*T: Clone` blanket to lean on the way `Display` has one - its `Self` would be
// `*T`, but a pointer clone that returns the pointer is an alias, so `*T` is left
// un-`Clone` and `p.clone()` on the `*T` from `get_ptr` dispatches straight to
// `T`'s own impl through the `T: Clone` bound.
extend Vec<T>: Clone where T: Clone {
    proc clone(*self) Vec<T> {
        let out: Vec<T> = Vec::<T>::with_capacity(self.len());
        let i: u64 = 0u64;
        while (i < self.len()) {
            out.push(self.get_ptr(i).unwrap().clone());
            i = i + 1u64;
        }
        return out;
    }
}

/// Read an element as an owned, independent clone - the owning-`T` counterpart
/// to `get`. Where `get` copies the bits out (a move out of an index the Vec
/// still owns, which the ownership pass rejects for an owner), `get_cloned`
/// borrows the element and deep-copies it, leaving the Vec's own copy in place.
/// A method-level bound can't be written (`where` attaches only to `extend`), so
/// this lives in its own `extend Vec<T> where T: Clone` block rather than the
/// struct body. Out-of-bounds is undefined; guard with len.
extend Vec<T> where T: Clone {
    pub proc get_cloned(*self, i: u64) T {
        return self.get_ptr(i).unwrap().clone();
    }
}

/// The destructor: destroy every element, then release the buffer. Called for
/// you when the Vec goes out of scope - never by hand. `drop_in_place` expands to
/// one `delete` per element (and to nothing when `T` owns nothing), and the
/// `cap != 0` guard leaves an unallocated (freshly `new`'d) Vec untouched.
extend Vec<T>: Delete {
    proc delete(*self) {
        drop_in_place::<T>(self.data, self.len);
        if (self.cap != 0u64) {
            dealloc::<T>(self.data);
        }
    }
}

// `Vec<T>` is `Display` exactly when its elements are: `[a, b, c]`. Each element
// is displayed through a borrow (`get_ptr` gives a `*T`, and `display` takes
// `*self`), so an owning element is never moved out; the per-element `String` is
// dropped at the end of its loop iteration.
extend Vec<T>: Display where T: Display {
    proc display(*self) String {
        let s: String = String::from_str("[");
        let n: u64 = self.len();
        let i: u64 = 0u64;
        while (i < n) {
            if (i > 0u64) { s.push_str(", "); }
            let ep: *T = self.get_ptr(i).unwrap();
            let part: String = ep.display();
            s.push_str(part.as_str());
            i = i + 1u64;
        }
        s.push_byte(93u8); // ']'
        return s;
    }
}
