extend f32 {
    /// Reinterpret an IEEE 754 bit pattern without numerical conversion.
    /// Preserves signed zero, infinities, subnormals, and NaN payloads.
    pub proc from_bits(bits: u32) f32 with [] {
        return *ptr_cast::<*f32>(&bits);
    }

    /// Decode an IEEE 754 bit pattern in little-endian byte order.
    pub proc from_le_bytes(bytes: [u8; 4]) f32 with [] {
        let bits = numerical_cast::<u32>(bytes[0u64])
            | (numerical_cast::<u32>(bytes[1u64]) << 8u32)
            | (numerical_cast::<u32>(bytes[2u64]) << 16u32)
            | (numerical_cast::<u32>(bytes[3u64]) << 24u32);
        return f32::from_bits(bits);
    }

    /// Decode an IEEE 754 bit pattern in big-endian byte order.
    pub proc from_be_bytes(bytes: [u8; 4]) f32 with [] {
        return f32::from_le_bytes([
            bytes[3u64],
            bytes[2u64],
            bytes[1u64],
            bytes[0u64],
        ]);
    }

    /// Encode the exact IEEE 754 bit pattern in little-endian byte order.
    pub proc to_le_bytes(self) [u8; 4] with [] {
        let bits = *ptr_cast::<*u32>(&self);
        return [
            numerical_cast::<u8>(bits & 0xffu32),
            numerical_cast::<u8>((bits >> 8u32) & 0xffu32),
            numerical_cast::<u8>((bits >> 16u32) & 0xffu32),
            numerical_cast::<u8>((bits >> 24u32) & 0xffu32),
        ];
    }

    /// Encode the exact IEEE 754 bit pattern in big-endian byte order.
    pub proc to_be_bytes(self) [u8; 4] with [] {
        let bytes = self.to_le_bytes();
        return [
            bytes[3u64],
            bytes[2u64],
            bytes[1u64],
            bytes[0u64],
        ];
    }
}

extend f64 {
    /// Reinterpret an IEEE 754 bit pattern without numerical conversion.
    /// Preserves signed zero, infinities, subnormals, and NaN payloads.
    pub proc from_bits(bits: u64) f64 with [] {
        return *ptr_cast::<*f64>(&bits);
    }

    /// Decode an IEEE 754 bit pattern in little-endian byte order.
    pub proc from_le_bytes(bytes: [u8; 8]) f64 with [] {
        let bits = numerical_cast::<u64>(bytes[0u64])
            | (numerical_cast::<u64>(bytes[1u64]) << 8u64)
            | (numerical_cast::<u64>(bytes[2u64]) << 16u64)
            | (numerical_cast::<u64>(bytes[3u64]) << 24u64)
            | (numerical_cast::<u64>(bytes[4u64]) << 32u64)
            | (numerical_cast::<u64>(bytes[5u64]) << 40u64)
            | (numerical_cast::<u64>(bytes[6u64]) << 48u64)
            | (numerical_cast::<u64>(bytes[7u64]) << 56u64);
        return f64::from_bits(bits);
    }

    /// Decode an IEEE 754 bit pattern in big-endian byte order.
    pub proc from_be_bytes(bytes: [u8; 8]) f64 with [] {
        return f64::from_le_bytes([
            bytes[7u64],
            bytes[6u64],
            bytes[5u64],
            bytes[4u64],
            bytes[3u64],
            bytes[2u64],
            bytes[1u64],
            bytes[0u64],
        ]);
    }

    /// Encode the exact IEEE 754 bit pattern in little-endian byte order.
    pub proc to_le_bytes(self) [u8; 8] with [] {
        let bits = *ptr_cast::<*u64>(&self);
        return [
            numerical_cast::<u8>(bits & 0xffu64),
            numerical_cast::<u8>((bits >> 8u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 16u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 24u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 32u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 40u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 48u64) & 0xffu64),
            numerical_cast::<u8>((bits >> 56u64) & 0xffu64),
        ];
    }

    /// Encode the exact IEEE 754 bit pattern in big-endian byte order.
    pub proc to_be_bytes(self) [u8; 8] with [] {
        let bytes = self.to_le_bytes();
        return [
            bytes[7u64],
            bytes[6u64],
            bytes[5u64],
            bytes[4u64],
            bytes[3u64],
            bytes[2u64],
            bytes[1u64],
            bytes[0u64],
        ];
    }
}
