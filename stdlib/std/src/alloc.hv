//! Typed heap allocation.
//!
//! `alloc`, `realloc` and `dealloc` manage raw heap buffers of `count` values of
//! a type `T`, sized automatically from `sizeof::<T>()`. Allocation can fail, so
//! each returns an `Option<*T>` that is `none` on failure; take the pointer out
//! with `.unwrap()` (or `.unwrap_or(...)`) before dereferencing. Memory is not
//! freed for you; pass every buffer you allocate to `dealloc` when done. These
//! are the primitives higher level containers like `Vec<T>` are built on.

// backed by rt_alloc/rt_realloc/rt_free in std/c/rt.c (always linked in). the raw
// externs deal in untyped `*void`; the generic wrappers add the typing + sizing.

import core/option { Option }

extern rt_alloc(size: u64) *void with Alloc;
extern rt_realloc(ptr: *void, size: u64) *void with Alloc;
extern rt_free(ptr: *void) void with Alloc;

/// Allocate uninitialized room for `count` values of type `T`. Returns `Some(*T)`
/// pointer on success, or `None` if the allocation failed or the byte size
/// `count * sizeof::<T>()` does not fit in a `u64`.
pub proc alloc<T>(count: u64) Option<*T> {
    let elem: u64 = sizeof::<T>();
    let size: u64 = count * elem;
    // nobody really allocates 2^61 or more bytes (i hope so), but if they do,
    // we handle that for them :)
    if (elem != 0u64 && size / elem != count) {
        return Option::None;
    }
    let ptr: *void = rt_alloc(size);
    if (ptr == null::<*void>()) {
        return Option::None;
    }
    return Option::Some(ptr_cast::<*T>(ptr));
}

/// Resize the allocation at `ptr` to hold `count` values of type `T`, preserving
/// existing contents. Returns `some` new pointer on success, or `none` on
/// failure or size overflow (in which case the original allocation is left
/// untouched).
@noalias
pub proc realloc<T>(ptr: *T, count: u64) Option<*T> {
    let elem: u64 = sizeof::<T>();
    let size: u64 = count * elem;
    if (elem != 0u64 && size / elem != count) {
        return Option::None;
    }
    let new_ptr: *void = rt_realloc(ptr_cast::<*void>(ptr), size);
    if (new_ptr == null::<*void>()) {
        return Option::None;
    }
    return Option::Some(ptr_cast::<*T>(new_ptr));
}

/// Release an allocation obtained from `alloc`/`realloc`. Using `ptr` afterward
/// is undefined.
@noalias
pub proc dealloc<T>(ptr: *T) void {
    rt_free(ptr_cast::<*void>(ptr));
}
