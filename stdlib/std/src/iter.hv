/// The iterator protocol used by `for` loops. `next` returns `Some(item)` until
/// exhausted, then `None`. Each implementation defines its associated `Item`.
///
///     for (x in it) { ... }
///
/// The iterand is evaluated once, then `next` is called until it returns `None`.

import option { Option }

pub trait Iterator {
    type Item;
    proc next(*self) Option<Self::Item>;
}
