/// The iterator protocol used by `for` loops. `next` returns `Some(item)` until
/// exhausted, then `None`. Each implementation defines its associated `Item`.
///
///     for (x in it) { ... }
///
/// The iterand is evaluated once, then `next` is called until it returns `None`.

import option { Option }

pub trait Iterator {
    type Item;
    proc next(*self) Option<Self::Item>;
}

/// Conversion into an iterator. The resulting iterator defines the yielded
/// item type through its `Iterator::Item` associated type.
pub trait IntoIterator {
    type IntoIter: Iterator;
    proc into_iter(self) Self::IntoIter;
}

/// Every iterator is already an iterator source; converting it is the identity.
extend I: IntoIterator where I: Iterator {
    type IntoIter = I;
    proc into_iter(self) I { return self; }
}
