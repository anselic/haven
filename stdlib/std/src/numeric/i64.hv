proc i64_string(n: i64) String {
    if (n < 0i64) {
        // Negate before adding one so i64::MIN never overflows.
        let magnitude: u64 = numerical_cast::<u64>(0i64 - (n + 1i64)) + 1u64;
        let digits: String = magnitude.display();
        let s: String = String::from_str("-");
        s.push_str(digits.as_str());
        return s;
    }
    return numerical_cast::<u64>(n).display();
}

extend i64: Display {
    proc display(*self) String {
        return i64_string(*self);
    }
}
