//! Copy, fill, and compare memory through typed pointers. Counts are in elements,
//! not bytes. These operations do not allocate or perform bounds checks.
//!
//! ```hv
//! mem::copy::<f32>(out, input, frames);
//! mem::zero::<f32>(tail, frames);
//! ```
//! Raw memory operations do not manage ownership. Callers must provide valid,
//! sufficiently large storage and must not copy or overwrite owning values.
//! `set` requires a `Copy` element type.

// libc takes untyped pointers and byte counts. The wrappers below convert
// from typed pointers and element counts. These externs do not allocate.
extern memcpy(dst: *void, src: *void, n: u64) *void without [Alloc];
extern memmove(dst: *void, src: *void, n: u64) *void without [Alloc];
extern memset(dst: *void, c: i32, n: u64) *void without [Alloc];
extern memcmp(a: *void, b: *void, n: u64) i32 without [Alloc];

/// Copy `count` elements from `src` to `dst`. The buffers must not overlap.
/// Use `copy_overlapping` if they might; overlap here is undefined behavior.
@noalias
pub proc copy<T>(dst: *T, src: *T, count: u64) void without [Alloc] {
    memcpy(ptr_cast::<*void>(dst), ptr_cast::<*void>(src), count * sizeof::<T>());
}

/// Copy `count` elements from `src` to `dst`, allowing overlap.
/// The result is as if the source bytes were saved before writing. Use this
/// when shifting elements within a buffer, such as during insertion or removal.
pub proc copy_overlapping<T>(dst: *T, src: *T, count: u64) void without [Alloc] {
    memmove(ptr_cast::<*void>(dst), ptr_cast::<*void>(src), count * sizeof::<T>());
}

/// Fill `count` slots with copies of `value`. Requires a `Copy` element type.
///
/// Write one element at a time because `memset` repeats a byte, not a `T`.
/// `ptr_write` does not destroy the previous contents of a slot.
@noalias
pub proc set<T>(dst: *T, value: T, count: u64) void without [Alloc] {
    let i: u64 = 0u64;
    while (i < count) {
        ptr_write::<T>(&dst[i], value);
        i = i + 1u64;
    }
}

/// Write zero bytes over `count` elements at `dst`.
///
/// Only read the result as `T` if all-zero bytes form a valid `T`. This clears
/// a sample buffer to silence, but is not a general way to create default
/// values. Any resources owned by overwritten values are not freed.
@noalias
pub proc zero<T>(dst: *T, count: u64) void without [Alloc] {
    memset(ptr_cast::<*void>(dst), 0, count * sizeof::<T>());
}

/// Compare the raw bytes of `count` elements. Returns a negative number if
/// `a` comes first in byte order, zero if equal, and a positive number otherwise.
///
/// This is not numeric ordering or value equality. For example, +0.0 and -0.0
/// have different bytes, and struct padding is included in the comparison.
pub proc compare<T>(a: *T, b: *T, count: u64) i32 without [Alloc] {
    return memcmp(ptr_cast::<*void>(a), ptr_cast::<*void>(b), count * sizeof::<T>());
}

/// Whether the buffers have identical bytes across `count` elements.
/// Uses the same byte comparison as `compare`, including any padding.
pub proc equal<T>(a: *T, b: *T, count: u64) bool without [Alloc] {
    return compare::<T>(a, b, count) == 0;
}

/// Exchange the values at `a` and `b`. The pointers may be the same.
pub proc swap<T>(a: *T, b: *T) void without [Alloc] {
    if (a == b) { return; }
    let tmp: T = ptr_read::<T>(a);
    ptr_write::<T>(a, ptr_read::<T>(b));
    ptr_write::<T>(b, tmp);
}

/// Write `value` into `slot` and return its previous value.
@noalias
pub proc replace<T>(slot: *T, value: T) T without [Alloc] {
    let old: T = ptr_read::<T>(slot);
    ptr_write::<T>(slot, value);
    return old;
}

/// Return the numeric address of `ptr`. The value is process-specific and may
/// differ between runs; use pointer equality when only identity matters.
pub proc address<T>(ptr: *T) u64 without [Alloc] { return ptr_addr::<T>(ptr); }

/// Return the size of `T` in bytes, including padding. This is also the
/// distance between consecutive array elements. Wraps the `sizeof` intrinsic.
pub proc size_of<T>() u64 without [Alloc] { return sizeof::<T>(); }
