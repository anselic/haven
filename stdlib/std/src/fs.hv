/// std/fs: filesystem operations, for build scripts and tooling.
///
/// A small, portable set of file and directory operations - read/write a whole
/// file, copy, make/remove a directory, rename, existence queries, and `join` to
/// build a path out of pieces - enough to drive a post-build `build.hv`. Paths
/// are plain `str`s.
///
/// Fallible calls return a `Result`: the value on `Ok`, or an `FsError` carrying
/// the underlying C `errno` on `Err`. Ask an `FsError` for its `message()` (a
/// human-readable string) or its raw `errno()`. The pure queries `exists` and
/// `is_dir` can't meaningfully fail, so they just return a `bool`.
///
///     import fs
///     import result { Result }
///
///     match (fs::read("config.txt")) {
///         Result::Ok(text) -> { /* use text */ }
///         Result::Err(e)   -> { println(e.message()); }
///     }

// Every operation is a thin wrapper over a platform-normalized `rt_fs_*` shim in
// std/c/fs.c (see there for the Windows/POSIX differences it papers over). The
// shims report failure as a nonzero `errno`; the wrappers turn that into an
// `Err(FsError)`. `read` adopts the shim's malloc'd buffer straight into a
// `Vec<u8>` via `from_raw_parts` (no copy), since rt_alloc and libc malloc are
// the same allocator.

import result { Result, Unit }
import string { String }
import vec { Vec }

extern rt_fs_read(path: str, out_len: *u64, out_err: *i32) *u8;
extern rt_fs_write(path: str, data: *u8, len: u64, out_written: *u64) i32;
extern rt_fs_copy(src: str, dst: str, out_bytes: *u64) i32;
extern rt_fs_mkdir(path: str) i32;
extern rt_fs_remove(path: str) i32;
extern rt_fs_rename(src: str, dst: str) i32;
extern rt_fs_exists(path: str) i32;
extern rt_fs_is_dir(path: str) i32;
extern rt_fs_strerror(code: i32) str;

/// A filesystem error, wrapping the C `errno` captured where the call failed.
pub struct FsError {
    code: i32,

    /// The raw C `errno` for this error (e.g. `2` for "no such file").
    pub proc errno(*self) i32 { return self.code; }

    /// A borrowable, human-readable description of the error, from `strerror`.
    /// Valid until the next `strerror` call; copy it into a `String` to keep it.
    pub proc message(*self) str { return rt_fs_strerror(self.code); }
}

/// Read the entire contents of the file at `path` into an owned `String` (with
/// no UTF-8 validation - treat the bytes as raw unless you know they are text).
pub proc read(path: str) Result<String, FsError> {
    let len: u64 = 0u64;
    let err: i32 = 0i32;
    let buf: *u8 = rt_fs_read(path, &len, &err);
    if (buf == null::<*u8>()) {
        return Result::Err(FsError { code: err });
    }
    // adopt the malloc'd buffer directly: `len` bytes are live, and the shim over-
    // allocated one byte for the NUL, so the true capacity is at least `len + 1`.
    let bytes: Vec<u8> = Vec::<u8>::from_raw_parts(buf, len, len + 1u64);
    return Result::Ok(String::from_bytes(bytes));
}

/// Write the bytes of `contents` to `path`, creating it or truncating an existing
/// file. On success yields the number of bytes written. Borrows `contents`.
pub proc write(path: str, contents: *String) Result<u64, FsError> {
    let written: u64 = 0u64;
    let data: *u8 = contents.as_bytes();
    let e: i32 = rt_fs_write(path, data, contents.len(), &written);
    if (e != 0i32) {
        return Result::Err(FsError { code: e });
    }
    return Result::Ok(written);
}

/// Copy the file `src` to `dst`, creating or truncating `dst`. On success yields
/// the number of bytes copied.
pub proc copy(src: str, dst: str) Result<u64, FsError> {
    let bytes: u64 = 0u64;
    let e: i32 = rt_fs_copy(src, dst, &bytes);
    if (e != 0i32) {
        return Result::Err(FsError { code: e });
    }
    return Result::Ok(bytes);
}

/// Create the directory `path`. Fails if it already exists or a parent is
/// missing (this creates a single level, not the whole chain).
pub proc mkdir(path: str) Result<Unit, FsError> {
    let e: i32 = rt_fs_mkdir(path);
    if (e != 0i32) {
        return Result::Err(FsError { code: e });
    }
    return Result::Ok(Unit::Unit);
}

/// Create the directory `path` and any missing parents, like Rust's
/// `fs::create_dir_all`. Components are split on `/` (the separator this project
/// uses throughout), and each prefix is created in turn; a level that already
/// exists as a directory is not an error, so calling it on an existing tree is a
/// no-op. Only a genuine failure - a missing permission, a parent that is a file,
/// etc. - yields `Err`. A leading `/` is kept (absolute paths), and repeated or
/// trailing separators collapse away.
pub proc mkdir_all(path: str) Result<Unit, FsError> {
    let full: String = String::from_str(path);
    let parts: Vec<String> = full.split(47u8);  // '/'
    let acc: String = String::new();            // the prefix built up so far
    let ends_sep: bool = false;                 // does `acc` already end with '/'?
    let n: u64 = parts.len();
    let i: u64 = 0u64;
    while (i < n) {
        let part: *String = parts.get_ptr(i).unwrap();
        if (part.is_empty()) {
            // a leading empty component means an absolute path ("/..."): keep the
            // root slash. Interior/trailing empties come from "//" or a trailing
            // "/", and collapse away.
            if (i == 0u64) {
                acc.push_byte(47u8);
                ends_sep = true;
            }
            i = i + 1u64;
            continue;
        }
        // join onto the prefix with a separator, unless there is nothing to join
        // to yet or one is already there.
        if (!acc.is_empty() && !ends_sep) {
            acc.push_byte(47u8);
        }
        acc.push_string(part);
        ends_sep = false;
        // create this prefix; an already-present directory is fine, anything else
        // (checked via `is_dir` so we don't depend on a specific errno) is fatal.
        match (mkdir(acc.as_str())) {
            Result::Ok(_)  -> {}
            Result::Err(e) -> {
                if (!is_dir(acc.as_str())) {
                    return Result::Err(e);
                }
            }
        }
        i = i + 1u64;
    }
    return Result::Ok(Unit::Unit);
}

/// Remove the file or empty directory at `path`.
pub proc remove(path: str) Result<Unit, FsError> {
    let e: i32 = rt_fs_remove(path);
    if (e != 0i32) {
        return Result::Err(FsError { code: e });
    }
    return Result::Ok(Unit::Unit);
}

/// Rename (or move) `src` to `dst`.
pub proc rename(src: str, dst: str) Result<Unit, FsError> {
    let e: i32 = rt_fs_rename(src, dst);
    if (e != 0i32) {
        return Result::Err(FsError { code: e });
    }
    return Result::Ok(Unit::Unit);
}

/// Whether anything (file or directory) exists at `path`.
pub proc exists(path: str) bool {
    return rt_fs_exists(path) == 1i32;
}

/// Whether `path` exists and is a directory.
pub proc is_dir(path: str) bool {
    return rt_fs_is_dir(path) == 1i32;
}

/// Whether `b` is a path separator. Both spellings count: a path handed to a
/// build script on Windows arrives with `\`, and one this module built has `/`.
proc is_sep(b: u8) bool {
    return b == 47u8 || b == 92u8;   // '/', '\'
}

/// Join `leaf` onto `base`, with exactly one separator between them.
///
///     fs::join("dist", "VERSION")     // "dist/VERSION"
///     fs::join("dist/", "VERSION")    // "dist/VERSION" - not "dist//VERSION"
///     fs::join("", "VERSION")         // "VERSION"      - no leading separator
///
/// Both sides are `str`, which is what a literal is and what `String::as_str`
/// hands back, so a path built from a mixture of the two composes without a
/// `String` per step. The result is owned, and is the input to the next `join`
/// via `.as_str()`.
///
/// The inserted separator is `/`, the separator this module uses throughout and
/// the one `mkdir_all` splits on; Windows accepts it everywhere. Separators
/// already present are **not** rewritten, so joining onto a `\`-spelled path
/// yields a mixed-separator result - ugly to read, accepted by every API that
/// takes it, and the only safe choice: normalizing would corrupt the `\\?\`
/// verbatim prefix Windows uses for long paths, which is meaningless with
/// forward slashes.
///
/// An empty side contributes nothing and no separator, so joining onto an empty
/// accumulator is a safe way to start a path. Otherwise a separator is inserted
/// only when neither side already carries one, which makes the call idempotent
/// with respect to trailing and leading slashes.
pub proc join(base: str, leaf: str) String {
    let head: String = String::from_str(base);
    let tail: String = String::from_str(leaf);
    if (head.is_empty()) { return tail; }
    if (tail.is_empty()) { return head; }

    // exactly one separator: skip inserting when either side supplies it.
    let head_bytes: *u8 = head.as_bytes();
    let tail_bytes: *u8 = tail.as_bytes();
    let joined: bool = is_sep(head_bytes[head.len() - 1u64]) || is_sep(tail_bytes[0u64]);
    if (!joined) {
        head.push_byte(47u8);   // '/'
    }
    head.push_string(&tail);
    return head;
}
