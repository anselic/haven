/// std/rand: repeatable pseudo-random numbers using PCG32.
///
/// `Rng` stores two `u64` words and never allocates. It is useful for noise,
/// dithering, simulations, and tests. The same seed and stream produce the
/// same sequence. Do not use it for cryptography.
///
///     let rng: Rng = Rng::new(0x853c49e6748fea9bu64);
///     let noise: f32 = rng.bipolar_f32();
///
/// All methods are `@alloc(false)`. Most take a fixed number of steps, but
/// `below` retries rejected draws and has no fixed iteration limit.

// PCG32 updates a 64-bit state with a multiply and add, then mixes and rotates
// the old state to produce 32 output bits. `inc` selects the stream and must
// be odd. Return the mixed output, not the raw state.

/// The multiplier specified by PCG32. Changing it changes the generator.
@alloc(false)
proc mult() u64 { return 6364136223846793005u64; }

/// The default stream selector passed to `Rng::with_stream`.
@alloc(false)
proc default_stream() u64 { return 1442695040888963407u64; }

/// A PCG32 generator with a 64-bit state and an odd stream increment.
/// Copying it saves the current position: both copies then produce the same
/// sequence until they are advanced differently.
pub struct Rng {
    state: u64,  /// state advanced by each 32-bit draw
    inc: u64,    /// stream increment; always odd

    /// Create a generator with `seed` on the default stream. Zero is a valid seed.
    @alloc(false)
    pub proc new(seed: u64) Rng {
        return Rng::with_stream(seed, default_stream());
    }

    /// Create a generator with `seed` on the selected stream.
    /// Use separate streams for voices or workers that need their own sequence.
    /// Only the low 63 bits of `stream` are used; shifting left makes room for
    /// the low bit that keeps `inc` odd.
    @alloc(false)
    pub proc with_stream(seed: u64, stream: u64) Rng {
        let r: Rng = Rng { state: 0u64, inc: (stream << 1u64) | 1u64 };
        // PCG initialization: advance once, add the seed, then advance again.
        r.step();
        r.state = r.state + seed;
        r.step();
        return r;
    }

    /// Advance the internal state once. Use `next_u32` to get mixed output bits.
    @alloc(false)
    proc step(*self) {
        self.state = self.state * mult() + self.inc;
    }

    /// Return the next 32 random bits, mixed from the state before advancing it.
    @alloc(false)
    pub proc next_u32(*self) u32 {
        let s: u64 = self.state;
        self.step();
        // Mix the state bits and keep 32 bits of the result.
        let xorshifted: u32 = numerical_cast::<u32>(((s >> 18u64) ^ s) >> 27u64);
        // Use the top 5 state bits as the rotation count.
        let rot: u32 = numerical_cast::<u32>(s >> 59u64);
        return (xorshifted >> rot) | (xorshifted << ((0u32 - rot) & 31u32));
    }

    /// Combine two 32-bit draws into one `u64`, first draw in the high half.
    /// Advances the generator twice.
    @alloc(false)
    pub proc next_u64(*self) u64 {
        let hi: u64 = numerical_cast::<u64>(self.next_u32());
        let lo: u64 = numerical_cast::<u64>(self.next_u32());
        return (hi << 32u64) | lo;
    }

    /// Return a uniform integer in `[0, bound)`, or 0 if `bound` is zero.
    /// Reject part of the draw range so each remainder is equally likely.
    /// This avoids the bias of a plain `% bound`, but may take repeated draws.
    @alloc(false)
    pub proc below(*self, bound: u32) u32 {
        if (bound == 0u32) { return 0u32; }
        // This is 2^32 % bound using wrapping arithmetic. Reject values below
        // it so the accepted range has a length divisible by `bound`.
        let threshold: u32 = (0u32 - bound) % bound;
        while (true) {
            let r: u32 = self.next_u32();
            if (r >= threshold) {
                return r % bound;
            }
        }
        return 0u32;  // unreachable: the loop returns an accepted draw
    }

    /// Return an `f32` in `[0, 1)` using 24 random bits.
    /// Every step of size 2^-24 is equally likely. Limiting the draw to 24 bits
    /// keeps the integer conversion exact and the result below 1.
    @alloc(false)
    pub proc next_f32(*self) f32 {
        let bits: u32 = self.next_u32() >> 8u32;          // 24 bits
        return numerical_cast::<f32>(bits) * 0.00000005960464477539063f32;  // 2^-24
    }

    /// Return an `f64` in `[0, 1)` using 53 random bits from two draws.
    /// Every step of size 2^-53 is equally likely.
    @alloc(false)
    pub proc next_f64(*self) f64 {
        let bits: u64 = self.next_u64() >> 11u64;         // 53 bits
        return numerical_cast::<f64>(bits) * 0.00000000000000011102230246251565f64;  // 2^-53
    }

    /// Return an `f32` in `[-1, 1)`, useful for audio noise.
    /// The result can be -1 but never +1.
    @alloc(false)
    pub proc bipolar_f32(*self) f32 {
        return self.next_f32() * 2.0f32 - 1.0f32;
    }

    /// Return an `f64` in `[-1, 1)`.
    @alloc(false)
    pub proc bipolar_f64(*self) f64 {
        return self.next_f64() * 2.0f64 - 1.0f64;
    }

    /// Return `true` or `false` with equal probability, using one draw.
    @alloc(false)
    pub proc next_bool(*self) bool {
        return (self.next_u32() >> 31u32) == 1u32;
    }

    /// Scale a draw to the range from `lo` to `hi`. Bounds are not checked.
    /// For finite `lo < hi`, the intended range is `[lo, hi)`, though floating-point
    /// rounding can produce `hi`.
    @alloc(false)
    pub proc range_f32(*self, lo: f32, hi: f32) f32 {
        return lo + self.next_f32() * (hi - lo);
    }

    /// Scale an `f64` draw from `lo` to `hi`, with the same bounds and rounding
    /// behavior as `range_f32`.
    @alloc(false)
    pub proc range_f64(*self, lo: f64, hi: f64) f64 {
        return lo + self.next_f64() * (hi - lo);
    }
}
