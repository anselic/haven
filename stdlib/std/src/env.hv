/// std/env: the process environment - variables, arguments, working directory,
/// and exit, for build scripts and tooling.
///
/// Read a single variable with `var` (`Some(value)` if set, `None` if not), set
/// one with `set_var`, list the program's arguments with `args`, ask for the
/// current working directory with `current_dir`, or end the process with `exit`.
///
/// The two value-returning reads differ in how "absent" is modeled: an unset
/// variable is an ordinary, expected outcome, so `var` yields `Option<String>`;
/// failing to read the working directory is a real error, so `current_dir` and
/// `set_var` yield a `Result` whose `Err` carries an `EnvError` (a wrapped C
/// `errno` you can ask for its `message()` or raw `errno()`).
///
///     import env
///     import option { Option }
///
///     match (env::var("HOME")) {
///         Option::Some(h) -> { print("home: "); println(h.as_str()); }
///         Option::None    -> { println("HOME is unset"); }
///     }

// Each operation is a thin wrapper over a platform-normalized `rt_env_*` shim in
// std/c/env.c (see there for the Windows/POSIX differences it papers over). `var`
// and `current_dir` adopt the shim's malloc'd, NUL-terminated buffer straight
// into a `String` via `from_raw_parts`/`from_bytes` (no copy), exactly as
// `fs::read` does. `args` builds a `Vec<str>` of borrowed argv pointers, which
// the runtime keeps alive for the whole program.

import option { Option }
import result { Result, Unit }
import string { String }
import vec { Vec }

extern rt_env_argc() u64;
extern rt_env_arg(i: u64) str;
extern rt_env_get(name: str, out_len: *u64) *u8;
extern rt_env_set(name: str, value: str) i32;
extern rt_env_cwd(out_len: *u64, out_err: *i32) *u8;
extern rt_env_exit(code: i32) !;
extern rt_env_strerror(code: i32) str;

/// An environment error, wrapping the C `errno` captured where the call failed.
pub struct EnvError {
    code: i32,

    /// The raw C `errno` for this error.
    pub proc errno(*self) i32 { return self.code; }

    /// A borrowable, human-readable description of the error, from `strerror`.
    /// Valid until the next `strerror` call; copy it into a `String` to keep it.
    pub proc message(*self) str { return rt_env_strerror(self.code); }
}

/// The value of the environment variable `name` as an owned `String`, or `None`
/// if it is not set. The bytes are copied out of the environment, so the returned
/// `String` is yours to keep and outlives any later change to the variable.
pub proc var(name: str) Option<String> {
    let len: u64 = 0u64;
    let buf: *u8 = rt_env_get(name, &len);
    if (buf == null::<*u8>()) {
        return Option::None::<String>();
    }
    // adopt the malloc'd buffer directly: `len` bytes are live, and the shim over-
    // allocated one byte for the NUL, so the true capacity is at least `len + 1`.
    let bytes: Vec<u8> = Vec::<u8>::from_raw_parts(buf, len, len + 1u64);
    return Option::Some::<String>(String::from_bytes(bytes));
}

/// Set the environment variable `name` to `value`, creating it or overwriting an
/// existing value. Affects this process (and any children spawned afterwards).
pub proc set_var(name: str, value: str) Result<Unit, EnvError> {
    let e: i32 = rt_env_set(name, value);
    if (e != 0i32) {
        return Result::Err::<Unit, EnvError>(EnvError { code: e });
    }
    return Result::Ok::<Unit, EnvError>(Unit::Unit);
}

/// The program's arguments, argv[0] first (conventionally the program name), each
/// a borrowed `str` valid for the whole program. Owns the returned `Vec`, not the
/// strings it points at.
pub proc args() Vec<str> {
    let n: u64 = rt_env_argc();
    let v: Vec<str> = Vec::<str>::with_capacity(n);
    let i: u64 = 0u64;
    while (i < n) {
        v.push(rt_env_arg(i));
        i = i + 1u64;
    }
    return v;
}

/// The current working directory as an owned `String`, or `Err(EnvError)` if it
/// could not be determined.
pub proc current_dir() Result<String, EnvError> {
    let len: u64 = 0u64;
    let err: i32 = 0i32;
    let buf: *u8 = rt_env_cwd(&len, &err);
    if (buf == null::<*u8>()) {
        return Result::Err::<String, EnvError>(EnvError { code: err });
    }
    let bytes: Vec<u8> = Vec::<u8>::from_raw_parts(buf, len, len + 1u64);
    return Result::Ok::<String, EnvError>(String::from_bytes(bytes));
}

/// End the process immediately with status `code`, running no further haven code.
/// Never returns (its `!` return type says so), so it type-checks anywhere and a
/// caller needs no follow-up `return`.
pub proc exit(code: i32) ! {
    rt_env_exit(code);
}
