// CLAP ABI bindings — audio-buffer.h + process.h

import events { ClapEventTransport, ClapInputEvents, ClapOutputEvents }

// typedef struct clap_audio_buffer — one per port; exactly one of data32/data64
// is non-null. `float **data32` -> `**f32`.
@repr(C)
pub struct ClapAudioBuffer {
    data32: **f32,
    data64: **f64,
    channel_count: u32,
    latency: u32,
    constant_mask: u64,
}

// clap_process_status (int32_t).
@repr(i32)
pub enum ClapProcessStatus {
    Error = 0,
    Continue = 1,
    ContinueIfNotQuiet = 2,
    Tail = 3,
    Sleep = 4,
}

// typedef struct clap_process — passed to clap_plugin.process().
@repr(C)
pub struct ClapProcess {
    steady_time: i64,
    frames_count: u32,
    transport: *ClapEventTransport,
    audio_inputs: *ClapAudioBuffer,
    audio_outputs: *ClapAudioBuffer,
    audio_inputs_count: u32,
    audio_outputs_count: u32,
    in_events: *ClapInputEvents,
    out_events: *ClapOutputEvents,
}
