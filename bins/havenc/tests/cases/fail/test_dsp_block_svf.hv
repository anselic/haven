// Conforming to `Mono` through an inherent method is a real check, not a name
// match. `StateVariable` has a `process(*self, x: f32)` like every filter in
// `dsp/filters`, but it returns all four responses at once, so it is not a
// one-in-one-out block and the empty `extend` is rejected.
//
// This is the negative half of `run/test_dsp_block.hv`, where the same empty
// block *does* conform for `Biquad` and `OnePole`. Without it, "the filters
// implement `Mono` with no adapter" would be indistinguishable from "any type
// with a method spelled `process` is admitted".
//@ dep: dsp=stdlib/dsp
//@ error: signature mismatch on

import dsp/block { Mono }
import dsp/filters { StateVariable }

extend StateVariable: Mono {}

@export
proc main() i32 { return 0; }
