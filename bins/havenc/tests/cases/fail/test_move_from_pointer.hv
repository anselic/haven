// A pointer is a borrow. Moving the pointee out through it would leave whatever
// owns it holding an invalid value.
//@ error: cannot move a 'Buf' out of a pointer or an element
import std/alloc { alloc, dealloc }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = alloc::<i32>(1u64).unwrap();
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

@export
proc main() i32 {
    let a: Buf = Buf::make(1);
    let p: *Buf = &a;
    let b: Buf = *p;
    return 0;
}
