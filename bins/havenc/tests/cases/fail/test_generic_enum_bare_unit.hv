//@ error: cannot infer type argument `T` for `Option::None`
// a bare unit variant of a generic enum has no payload to infer `T` from and no
// syntax for a turbofish, so it needs an expectation to take `T` from. With
// nothing around it (`let a = ...` with no annotation) there is none.
enum Option<T> { None, Some(T) }

@export
proc main() i32 {
    let a = Option::None;
    return 0;
}
