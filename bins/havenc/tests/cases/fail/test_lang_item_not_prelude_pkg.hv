// A lang item may only be claimed by the package supplying the prelude.
//
// `@lang(delete)` does not merely name a trait - it decides what *owning a
// resource* means for every type in the program, and there is exactly one such
// decision. A second claimant would leave two `Delete` traits with the
// ownership pass able to insert calls for only one of them, silently treating
// the other's owners as `Copy`. So this is an error, where a stray `@!prelude`
// is merely inert: ignoring *this* mark is the miscompile.
//
// This also pins the grammar: attributes on a `trait` must reach lang-item
// checking at all. Before traits carried attributes this died in the parser
// with "found 'trait' expected 'proc', 'extern', 'struct', 'enum', or 'const'".
//@ error: may only be declared by 'std'

@lang(delete)
pub trait Marker {
    proc mark(*self);
}

@export
proc main() i32 {
    return 0;
}
