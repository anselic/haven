// An `extend T: Trait` block may only bind associated types the trait declares.
// `Elem` is not one of `Iterator`'s associated types, so it is rejected.
//@ error: has no associated type 'Elem'

enum Option<T> { None, Some(T) }

trait Iterator {
    type Item;
    proc next(*self) Option<Self::Item>;
}

struct R { cur: i32 }

extend R: Iterator {
    type Item = i32;
    type Elem = i32;
    proc next(*self) Option<i32> {
        return Option::None::<i32>();
    }
}

@export
proc main() i32 {
    return 0;
}
