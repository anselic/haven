// The clause is checked where the parameter is actually bound: unifying the
// impl's target against the receiver. `f64` has no `MyDisplay`, so `Pair<f64>`
// never reaches this method.
//
// Without the check the call would be accepted and the failure would surface
// inside the *instantiated body* instead - "cannot access field 'my_display' on
// type f64", pointing at a line in the impl that the caller never wrote.
//@ error: type `f64` does not implement trait `MyDisplay`

trait MyDisplay {
    proc my_display(*self) str;
}

extend i32: MyDisplay { proc my_display(*self) str { return "i"; } }

struct Pair<T> { a: T, b: T }

extend Pair<T>: MyDisplay where T: MyDisplay {
    proc my_display(*self) str { return self.a.my_display(); }
}

@export
proc main() i32 {
    let p: Pair<f64> = Pair::<f64> { a: 1.0f64, b: 2.0f64 };
    println(p.my_display());
    return 0;
}
