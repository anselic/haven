// The default source is the return type, and `void` has no suffix.
//@ error: an extern returning `void` must name the overloaded parameters
//@ error: llvm.prefetch", p)

@llvm_intrinsic_infer("llvm.prefetch")
extern prefetch(p: *f32, rw: i32, locality: i32, cache: i32) void with [];

proc main() i32 { return 0; }
