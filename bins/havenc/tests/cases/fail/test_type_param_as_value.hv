// A *type* parameter read in value position.
//
// The name is declared - it is right there in the `extend` target - so reporting
// it as unknown reads like a typo. What is actually wrong is its kind: `T` names
// a type, and only a `const` parameter stands for a value.
//
// (The sibling case, a const parameter inferred from an `extend` target, used to
// land here too because `extend Buf<T, N>` bound both arguments as types. It is
// now classified against the declaration and works - see
// `run/test_extend_const_param.hv`.)
//@ error: type parameter 'T' cannot be used as a value
//@ error: names a type, not a value

struct Pair<T> { a: T, b: T }

extend Pair<T> {
    proc bad(*self) T { return T; }
}

@export
proc main() i32 {
    return 0;
}
