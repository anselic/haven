// Nothing owns the result, so nothing would ever destroy it.
//@ error: owns a resource but is discarded without an owner
import std/alloc { alloc, dealloc }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = alloc::<i32>(1u64).unwrap();
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

@export
proc main() i32 {
    Buf::make(1);
    return 0;
}
