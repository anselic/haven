// An `extend` block's parameters are inferred from its target, so a `where`
// clause can only bound a name the target actually mentions.
//
// Left to bind nothing, `where U: Display` would be a silent no-op and the body
// would fail much later with "no method on type parameter", pointing at the call
// rather than at the typo. The same check catches `where Pair: Display` - a
// bound on the target itself, which an impl has no way to state.
//@ error: does not bind

trait Display {
    proc display(*self) str;
}

struct Pair<T> { a: T, b: T }

extend Pair<T> where U: Display {
    proc first(*self) i32 { return 0; }
}

@export
proc main() i32 {
    return 0;
}
