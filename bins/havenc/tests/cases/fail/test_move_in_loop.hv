// The second iteration would move a value that the first one already gave away.
//@ error: is declared outside this loop
import std/alloc { alloc, dealloc }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = alloc::<i32>(1u64).unwrap();
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

@export
proc main() i32 {
    let n: i32 = 0;
    let a: Buf = Buf::make(1);
    while (n < 3) {
        consume(a);
        n = n + 1;
    }
    return 0;
}
