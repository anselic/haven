// The `for` iterand is re-evaluated each iteration as the `.next()` receiver, so
// it must be a place. A call like `mk()` would build a fresh iterator every pass;
// it is rejected with a hint to bind it to a `let` first.
//@ error: cannot be a call

import std/iter { Iterator }
import std/option { Option }

struct R { c: i32 }
extend R: Iterator {
    type Item = i32;
    proc next(*self) Option<i32> { return Option::None::<i32>(); }
}

proc mk() R { return R { c: 0 }; }

@export
proc main() i32 {
    for x in mk() {
        println(x);
    }
    return 0;
}
