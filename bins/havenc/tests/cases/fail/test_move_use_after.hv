// A value that owns a resource moves on assignment: the source is dead, and
// reading it would alias a buffer that its new owner will free.
//@ error: use of 'a' after its value was moved out of it
import std/alloc { alloc, dealloc }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = alloc::<i32>(1u64).unwrap();
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

@export
proc main() i32 {
    let a: Buf = Buf::make(1);
    let b: Buf = a;
    return peek(&a);
}
