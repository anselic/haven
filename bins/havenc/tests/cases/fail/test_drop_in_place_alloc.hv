// `drop_in_place` is not a leaf: it runs `T`'s destructors, and those may free.
//
// The alloc check reads the call graph off the AST and treats every intrinsic as
// clean, which is right for the others - they call nothing. This one would be a
// hole, and the reason it is not is that the ownership pass rewrites it into
// ordinary `delete` calls *before* the alloc check runs, so the destructors it
// reaches are edges like any other. The error names `Res$delete`, not the
// intrinsic, and points at the line the loop came from. (The name is package-
// anchored, `<package>$Res$delete`, so match only the type-and-method tail.)
//@ error: Res$delete', which may allocate

import std/alloc { alloc, dealloc }

struct Res { data: *i32 }

extend Res: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

@alloc(false)
proc sweep(p: *Res, n: u64) {
    drop_in_place::<Res>(p, n);
}

@export
proc main() i32 {
    let r: *Res = alloc::<Res>(1u64).unwrap();
    sweep(r, 0u64);
    dealloc::<Res>(r);
    return 0;
}
