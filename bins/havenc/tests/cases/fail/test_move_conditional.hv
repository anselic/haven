// Moved on one path and not the other: whether it still needs destroying is a
// runtime question, and there are no drop flags.
//@ error: not on every path
import std/alloc { alloc, dealloc }
import std/option { unwrap }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = unwrap::<i32>(alloc::<i32>(1u64));
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

@export
proc main() i32 {
    let n: i32 = 3;
    let a: Buf = Buf::make(1);
    if (n > 0) { consume(a); }
    return 0;
}
