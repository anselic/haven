// A path may end in a name, or in a type followed by one of its members. Any
// more segments after the module qualifier has been walked as far as it goes is
// an error rather than a silently dropped tail. `Rect::make` resolves - it is a
// real associated function - so what is rejected here is the trailing segment,
// not an unknown name.
//@ error: has too many `::` segments after the module qualifier
//@ dep: geom=bins/havenc/tests/pkgs/geom

import geom/shapes

@export
proc main() i32 {
    return shapes::rect::Rect::make::extra();
}
