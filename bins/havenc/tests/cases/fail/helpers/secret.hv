// Helper for `fail/test_private_trait.hv`. `Secret` has no `pub`, so it is not
// importable. (Stage-2 limitation: the trait *name* is still reserved
// program-wide, and a `T: Secret` bound still resolves globally - `pub` gates
// only whether another module can name it in an `import`.)
trait Secret {
    proc secret(*self) i32;
}
