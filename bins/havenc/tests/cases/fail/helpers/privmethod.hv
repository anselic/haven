// Helper for `fail/test_private_method.hv`. `Counter::make` is `pub` so it can be
// called from another module, but `bump` is not - a method is module-private
// unless marked `pub` (trait-impl methods excepted), the same rule top-level
// functions follow.
pub struct Counter { n: i32 }

extend Counter {
    pub proc make() Counter { return Counter { n: 0 }; }
    proc bump(*self) i32 { self.n = self.n + 1; return self.n; }
}
