// A comparison of two vectors is lane-wise: it gives a `simd<bool, N>` mask,
// not one `bool`, so it cannot be an `if` condition (reduce it with `any` or
// `all`). It once typechecked as `bool` and reached clang as `<4 x i1>` where
// `i1` was expected.
//@ error: expected `bool`, got `simd[bool, 4]`

import std/simd { simd_splat }

@export
proc main() i32 {
    let v: simd<f32, 4> = simd_splat::<f32, 4>(1.0f32);
    if (v < v) { return 1; }
    return 0;
}
