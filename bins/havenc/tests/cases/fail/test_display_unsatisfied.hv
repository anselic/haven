// `Vec<T>: Display` is conditional on `T: Display`. `Blob` has no `Display` impl,
// so `Vec<Blob>` does not implement `Display` either, and a bound requiring it
// must be rejected - naming the whole `Vec<Blob>`, not some failure buried inside
// the instantiated body.
//
// This is the negative side of resolving the impl's `where`-clause bound: the
// clause's trait must be looked up (`T: Display`), then asked of the argument
// (`Blob: Display` -> no), for the conditional impl to correctly *not* apply.
//@ error: does not implement trait `Display`

import std/fmt { Display, display_println }
import std/vec { Vec, vec_new, vec_push }

struct Blob { n: i32 }

@export
proc main() i32 {
    let v: Vec<Blob> = vec_new::<Blob>();
    vec_push::<Blob>(&v, Blob { n: 1 });
    display_println::<Vec<Blob>>(&v);
    return 0;
}
