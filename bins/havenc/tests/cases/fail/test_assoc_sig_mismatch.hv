// The impl binds `Item = i32`, so the trait's `next(*self) Option<Self::Item>`
// becomes `Option<i32>` — but the impl's `next` returns `Option<f32>`. The
// substituted signature and the impl's must agree.
//@ error: implements it differently from the trait

enum Option<T> { None, Some(T) }

trait Iterator {
    type Item;
    proc next(*self) Option<Self::Item>;
}

struct R { cur: i32 }

extend R: Iterator {
    type Item = i32;
    proc next(*self) Option<f32> {
        return Option::None::<f32>();
    }
}

@export
proc main() i32 {
    return 0;
}
