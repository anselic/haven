// Moving one owning field out of a value would leave the rest of it without an
// owner; partial moves are not supported.
//@ error: cannot move a 'Buf' out of a field of 'p'
import std/alloc { alloc, dealloc }

struct Buf {
    data: *i32,
    tag: i32,

    proc make(n: i32) Buf {
        let p: *i32 = alloc::<i32>(1u64).unwrap();
        return Buf { data: p, tag: n };
    }
}

extend Buf: Delete {
    proc delete(*self) { dealloc::<i32>(self.data); }
}

proc consume(b: Buf) i32 { return b.tag; }
proc peek(b: *Buf) i32 { return b.tag; }

struct Pair { left: Buf, n: i32 }

@export
proc main() i32 {
    let p: Pair = Pair { left: Buf::make(1), n: 2 };
    let b: Buf = p.left;
    return 0;
}
