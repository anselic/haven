// A turbofish on a non-generic function taken by value is an error: a plain
// function is already a concrete pointer and has no type parameters to bind.
//
//@ error: takes no type arguments
proc f(x: i32) i32 { return x; }

@export
proc main() i32 {
    let g: proc(i32) i32 = f::<i32>;
    return g(1);
}
