// A const parameter inferred from an `extend` target cannot be read as a value.
//
// `extend Buf<T, N>` binds both arguments as *type* parameters - the syntax
// gives no way to tell which is a const - so `N` in value position is source the
// compiler cannot honour yet rather than an unknown name. The old message
// claimed the latter, which reads as a typo in a name declared on the line above.
//
// (Declared in a binder, `proc f<const N: u64>() u64 { return N; }`, it works.)
//@ error: generic parameter 'N' cannot be used as a value here
//@ error: bound as a type parameter

struct Buf<T, const N: u64> { items: [T; N] }

extend Buf<T, N> {
    proc count(*self) u64 { return N; }
}

@export
proc main() i32 {
    return 0;
}
