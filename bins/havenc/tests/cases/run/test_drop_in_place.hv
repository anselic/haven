// `drop_in_place::<T>(ptr, count)` destroys `count` values starting at `ptr`.
//
// This is the loop a container's own destructor cannot write by hand: calling
// `delete` explicitly is an error, and the ownership pass only ever destroys a
// *statically* known chain of fields, so "N of them, N known at runtime" had no
// spelling. Together with `ptr_write` it makes a heap container that owns its
// elements expressible - the `Bag` below is `Vec` with the parts that matter.
//
// Two properties beyond "the elements get destroyed":
//
//   * `Bag` is `Delete` *unconditionally* - the allocation always needs freeing,
//     whatever `T` is - and it is the intrinsic, not a `where` clause, that
//     makes `Bag<i32>` pay nothing. `T` owning nothing expands to no loop at all.
//   * the elements are destroyed in index order, before the buffer is released.
//
// The element types are deliberately varied: `Owner` is pointer-sized and drops
// itself, `Wide` is larger than a pointer (so a wrong stride would overlap
// elements), and `Nested` owns *through a field* rather than implementing
// `Delete`, so the expansion walks a field chain per element. A sequence of
// structs is contiguous inline storage - `[N x %Name]`, sized by `size_of` - so
// `&buf[i]` strides by the real element and `buf[i].field` addresses inline
// bytes; none of these depend on the element being one word.
//@ exit: 0

import std/alloc { realloc, dealloc }
import std/option { unwrap }
import std/string { String, string_from_str, string_as_str, string_free }

struct Owner { data: *i32 }

extend Owner: Delete {
    proc delete(*self) {
        printf::<i32>("  drop owner %d\n", *self.data);
        dealloc::<i32>(self.data);
    }
}

// wider than a pointer: a mis-strided buffer would read a neighbour's bytes.
struct Wide { a: i32, b: i32, c: i32, owned: Owner }

extend Wide: Delete {
    proc delete(*self) {
        printf::<i32>("  drop wide %d\n", self.a);
        // its own field is this method's business, so destroy it by hand here.
        drop_in_place::<Owner>(&self.owned, 1u64);
    }
}

// owns through a field, with no `Delete` of its own: the element pass reaches
// `.held` on its own.
struct Nested { tag: i32, held: Owner }

struct Bag<T> { data: *T, len: u64, cap: u64 }

extend Bag<T>: Delete {
    proc delete(*self) {
        printf::<u64>("bag of %llu\n", self.len);
        drop_in_place::<T>(self.data, self.len);
        if (self.cap != 0u64) { dealloc::<T>(self.data); }
    }
}

proc bag_new<T>() Bag<T> {
    return Bag::<T> { data: null::<*T>(), len: 0u64, cap: 0u64 };
}

proc bag_push<T>(b: *Bag<T>, value: T) {
    if (b.cap < b.len + 1u64) {
        let grown: u64 = b.cap * 2u64;
        if (grown == 0u64) { grown = 4u64; }
        b.data = unwrap::<T>(realloc::<T>(b.data, grown));
        b.cap = grown;
    }
    // the slot is fresh capacity, so this initializes rather than overwrites
    ptr_write::<T>(&b.data[b.len], value);
    b.len = b.len + 1u64;
}

proc owner(n: i32) Owner {
    let p: *i32 = unwrap::<i32>(realloc::<i32>(null::<*i32>(), 1u64));
    ptr_write::<i32>(p, n);
    return Owner { data: p };
}

@export
proc main() i32 {
    // `T` owns nothing: the element pass expands to nothing, and the bag still
    // frees its buffer.
    let nums: Bag<i32> = bag_new::<i32>();
    bag_push::<i32>(&nums, 10);
    bag_push::<i32>(&nums, 20);
    printf::<i32>("nums %d", nums.data[0]);
    printf::<i32>(" %d\n", nums.data[1]);

    // `String` holds a `Vec<u8>`; nothing here may perturb it.
    let s: String = string_from_str("hi");
    println(string_as_str(&s));
    string_free(&s);

    // `T` owns and drops itself: three elements, destroyed in index order.
    let owners: Bag<Owner> = bag_new::<Owner>();
    bag_push::<Owner>(&owners, owner(1));
    bag_push::<Owner>(&owners, owner(2));
    bag_push::<Owner>(&owners, owner(3));

    // `T` is wider than a pointer, and reading `wides.data[0].a` back proves the
    // buffer strides by the real element rather than by a word.
    let wides: Bag<Wide> = bag_new::<Wide>();
    bag_push::<Wide>(&wides, Wide { a: 1, b: 2, c: 3, owned: owner(10) });
    bag_push::<Wide>(&wides, Wide { a: 4, b: 5, c: 6, owned: owner(11) });
    printf::<i32>("wide0 %d", wides.data[0].a);
    printf::<i32>(" wide1 %d\n", wides.data[1].a);

    // `T` owns through a field: the expansion walks to `.held` for each element.
    let nested: Bag<Nested> = bag_new::<Nested>();
    bag_push::<Nested>(&nested, Nested { tag: 7, held: owner(20) });
    bag_push::<Nested>(&nested, Nested { tag: 8, held: owner(21) });

    printf::<i32>("end of scope %d\n", 0);
    return 0;
}
