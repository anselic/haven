// std/bits: every operation cross-checked against the values GCC's builtins
// produce (__builtin_popcountll / clzll / ctzll and hand-rolled reference
// reversals) over a value ladder that covers zero, one, both extremes, a
// single high bit, a full word and a 32/64-bit boundary.
import std/bits

proc show(x: u64) void {
    println(bits::popcount_u64(x));
    println(bits::leading_zeros_u64(x));
    println(bits::trailing_zeros_u64(x));
    println(bits::bswap_u64(x));
    println(bits::reverse_bits_u64(x));
    println(bits::next_power_of_two_u64(x));
    println(bits::log2_floor_u64(x));
    println(bits::log2_ceil_u64(x));
    let x32: u32 = numerical_cast::<u32>(x);
    println(bits::popcount_u32(x32));
    println(bits::leading_zeros_u32(x32));
    println(bits::trailing_zeros_u32(x32));
    println(bits::bswap_u32(x32));
    println(bits::reverse_bits_u32(x32));
    println(bits::rotate_left_u32(x32, 7u32));
    println(bits::rotate_right_u32(x32, 7u32));
    println(bits::rotate_left_u32(x32, 0u32));
    println(bits::rotate_left_u64(x, 13u32));
    println(bits::rotate_right_u64(x, 13u32));
    println(bits::rotate_left_u64(x, 0u32));
    println(bits::bit_reverse_u32(x32, 10u32));
    println(bits::bit_reverse_u32(x32, 32u32));
    println(bits::bit_reverse_u32(x32, 0u32));
    println(bits::is_power_of_two_u64(x));
}

@export
proc main() i32 {
    show(0u64); show(1u64); show(2u64); show(255u64); show(1024u64);
    show(1023u64); show(0x8000000000000000u64); show(0xffffffffffffffffu64);
    show(0x123456789abcdef0u64); show(4294967296u64); show(3u64); show(0x80000000u64);
    return 0;
}
