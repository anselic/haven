// std/numeric: every operation cross-checked against the values GCC's builtins
// produce (__builtin_popcountll / clzll / ctzll and hand-rolled reference
// reversals) over a value ladder that covers zero, one, both extremes, a
// single high bit, a full word and a 32/64-bit boundary.
import std/numeric

proc show(x: u64) void {
    println(x.count_ones());
    println(x.leading_zeros());
    println(x.trailing_zeros());
    println(x.swap_bytes());
    println(x.reverse_bits());
    println(x.next_power_of_two());
    println(x.log2_floor());
    println(x.log2_ceil());
    let x32: u32 = numerical_cast::<u32>(x);
    println(x32.count_ones());
    println(x32.leading_zeros());
    println(x32.trailing_zeros());
    println(x32.swap_bytes());
    println(x32.reverse_bits());
    println(x32.rotate_left(7u32));
    println(x32.rotate_right(7u32));
    println(x32.rotate_left(0u32));
    println(x.rotate_left(13u32));
    println(x.rotate_right(13u32));
    println(x.rotate_left(0u32));
    println(x32.bit_reverse(10u32));
    println(x32.bit_reverse(32u32));
    println(x32.bit_reverse(0u32));
    println(x.is_power_of_two());
}

@export
proc main() i32 {
    show(0u64); show(1u64); show(2u64); show(255u64); show(1024u64);
    show(1023u64); show(0x8000000000000000u64); show(0xffffffffffffffffu64);
    show(0x123456789abcdef0u64); show(4294967296u64); show(3u64); show(0x80000000u64);
    return 0;
}
