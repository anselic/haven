// std/fmt: `Display`, a trait that renders a value as an owned `String`.
//
// Implemented for the integer primitives, `bool`, `str`, `String`, and - the
// interesting one - `Vec<T>` whenever `T: Display`. The last is a *conditional*
// impl on a generic container, so it exercises the whole stack: the `where`
// clause, calling a bounded method on the element type, and reaching all of that
// through the generic `display_println` helper (whose own `T: Display` bound must
// be satisfied by `Vec<i32>` as a whole).
//
// `display_println::<T>` exists because `string_as_str(&x.display())` cannot be
// written directly - you can't take the address of the temporary `x.display()` -
// so the helper binds it to a `let` for you.
//@ exit: 0

import std/fmt { Display, display_println }
import std/string { String }
import std/vec { Vec }

// a user type is displayable by composing the displays of its parts.
struct Point { x: i32, y: i32 }

extend Point: Display {
    proc display(*self) String {
        let s: String = String::from_str("(");
        let xs: String = self.x.display();
        s.push_str(xs.as_str());
        s.push_str(", ");
        let ys: String = self.y.display();
        s.push_str(ys.as_str());
        s.push_str(")");
        return s;
    }
}

@export
proc main() i32 {
    // --- primitives
    let a: i32 = 42;                        display_println::<i32>(&a);   // 42
    let b: i32 = -7;                        display_println::<i32>(&b);   // -7
    let z: u64 = 0u64;                      display_println::<u64>(&z);   // 0
    let big: u64 = 18446744073709551615u64; display_println::<u64>(&big); // u64 max
    let t: bool = true;                     display_println::<bool>(&t);  // true
    let f: bool = false;                    display_println::<bool>(&f);  // false

    // --- str and String
    let hello: str = "hello";               display_println::<str>(&hello);   // hello
    let owned: String = String::from_str("owned"); display_println::<String>(&owned); // owned

    // --- a Vec of primitives, rendered as `[a, b, c]`, through the helper (its
    // `T: Display` bound is `Vec<i32>: Display`, checked recursively).
    let v: Vec<i32> = Vec::<i32>::new();
    v.push(1);
    v.push(22);
    v.push(333);
    display_println::<Vec<i32>>(&v);        // [1, 22, 333]

    // --- an empty Vec renders as `[]`
    let empty: Vec<i32> = Vec::<i32>::new();
    display_println::<Vec<i32>>(&empty);    // []

    // --- nested containers: `T` here is itself a generic instance, so dispatch
    // has to put `Vec$i32` back into `Vec<i32>` form to find its impl.
    let outer: Vec<Vec<i32>> = Vec::<Vec<i32>>::new();
    let row0: Vec<i32> = Vec::<i32>::new();
    row0.push(1);
    row0.push(2);
    outer.push(row0);
    let row1: Vec<i32> = Vec::<i32>::new();
    row1.push(3);
    outer.push(row1);
    display_println::<Vec<Vec<i32>>>(&outer); // [[1, 2], [3]]

    // --- a user type, and a Vec of it
    let p: Point = Point { x: 7, y: 8 };
    display_println::<Point>(&p);           // (7, 8)
    let pts: Vec<Point> = Vec::<Point>::new();
    pts.push(Point { x: 1, y: 2 });
    pts.push(Point { x: 3, y: 4 });
    display_println::<Vec<Point>>(&pts);    // [(1, 2), (3, 4)]

    return 0;
}
