// `@fastmath(reassoc, nsz)` is the usual DSP choice: the reduction below may be
// reordered (and so vectorized), but NaN and infinity keep their meaning, so
// the NaN guard in `safe_sum` still works. `fast` would let LLVM delete it.

import std/numeric/f32

@inline(never)
@fastmath(reassoc, nsz)
proc safe_sum(buf: [f32], n: u64) f32 {
    let s = 0.0f32;
    let i = 0u64;
    while (i < n) {
        s = s + buf[i];
        i = i + 1u64;
    }
    if (s != s) { return -1.0f32; }
    return s;
}

@export
proc main() i32 {
    let ones: [f32] = [1.0f32; 64];
    println(safe_sum(ones, 64u64));          // 64

    let bad: [f32] = [1.0f32; 64];
    bad[17] = f32::from_bits(0x7fc00000u32);  // NaN
    println(safe_sum(bad, 64u64));           // -1
    return 0;
}
