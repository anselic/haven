// A `for` iterand may be any expression, including a call like `mk()`. It is
// evaluated exactly once into a hidden local before the loop, not re-run each
// pass. This program proves that: if the call were re-evaluated per iteration
// it would rebuild a fresh `R { c: 0 }` every time and never terminate. A
// clean run printing `0 1 2` shows the single-evaluation semantics.
//@ exit: 0

import std/iter { Iterator }
import std/option { Option }

struct R { c: i32 }
extend R: Iterator {
    type Item = i32;
    proc next(*self) Option<i32> {
        if (self.c >= 3) { return Option::None::<i32>(); } else {}
        let v = self.c;
        self.c = self.c + 1;
        return Option::Some::<i32>(v);
    }
}

proc mk() R { return R { c: 0 }; }

@export
proc main() i32 {
    for (x in mk()) {
        println(x);
    }
    return 0;
}
