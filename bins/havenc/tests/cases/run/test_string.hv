// std/string: build, borrow-as-`str`, compare, clear, and grow an owned String.
// Every String here is dropped automatically at end of scope (it owns its bytes
// through a `Vec<u8>` field), so there are no manual frees.

import std/string { String }

// bool isn't numeric, so funnel truthiness through an i32 for `%d` printing.
proc yn(b: bool) i32 { if (b) { return 1; } return 0; }

@export
proc main() i32 {
    // build a string from a mix of str fragments and raw bytes
    let s: String = String::new();
    s.push_str("Hello");
    s.push_byte(44u8);  // ','
    s.push_byte(32u8);  // ' '
    s.push_str("world");
    s.push_byte(33u8);  // '!'
    printf::<str>("%s\n", s.as_str()); // Hello, world!
    printf::<u64>("%llu\n", s.len());  // 13

    // seed from a literal
    let greet: String = String::from_str("hi");
    printf::<str>("%s\n", greet.as_str());       // hi
    printf::<i32>("%d\n", yn(greet.is_empty())); // 0

    // equality compares bytes, not identity
    let a: String = String::from_str("abc");
    let b: String = String::from_str("abc");
    let c: String = String::from_str("abd");
    printf::<i32>("%d\n", yn(a.eq(&b))); // 1
    printf::<i32>("%d\n", yn(a.eq(&c))); // 0

    // clear empties the logical length without freeing the buffer
    a.clear();
    printf::<i32>("%d\n", yn(a.is_empty())); // 1
    printf::<u64>("%llu\n", a.len());        // 0

    // the buffer doubles to absorb many pushes past its initial capacity
    let big: String = String::with_capacity(4u64);
    let i: i32 = 0;
    while (i < 100) {
        big.push_byte(120u8); // 'x'
        i = i + 1;
    }
    printf::<u64>("%llu\n", big.len());             // 100
    printf::<i32>("%d\n", yn(big.cap() >= 100u64)); // 1

    // no frees: every String above owns its buffer through a `Vec<u8>` field and
    // is destroyed automatically at the end of this scope.
    return 0;
}
