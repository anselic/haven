// The directory-namespace rule over a directory *inside a dependency artifact*
// (`geom/shapes`), which the compiler walks by a separate implementation from a
// leaf's on-disk modules - so it gets its own fixture rather than riding on the
// user-module one (`run/test_dir_namespace.hv`). Binds the `geom` fixture
// package, whose `shapes/` subtree is a real directory of modules in the
// emitted `.hvmeta`.
//@ exit: 0
//@ dep: geom=bins/havenc/tests/pkgs/geom

import geom/shapes

@export
proc main() i32 {
    // walk the `shapes/` namespace to a free function of `rect`, then to an
    // associated function of a type one level deeper still.
    let r: shapes::rect::Rect = shapes::rect::unit();
    let c: shapes::circle::Circle = shapes::circle::Circle::make(2.0f64);
    if (r.area() == 1 && c.diameter() == 4.0f64) { return 0; }
    return 1;
}
