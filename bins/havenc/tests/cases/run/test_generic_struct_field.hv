// A non-generic struct may hold a concrete generic instance as a field
// (`xs: Vec<i32>`): monomorphization rewrites the field type to the flat
// instance and emits it, so `String { buf: Vec<u8> }` and friends work without
// making the outer struct generic. Also exercises `pop`'s `Option<*T>`.

import std/vec { Vec }
import std/option { Option }

struct Pair { xs: Vec<i32>, tag: i32 }

@export
proc main() i32 {
    let p: Pair = Pair { xs: Vec::<i32>::new(), tag: 7 };
    p.xs.push(10);
    p.xs.push(20);
    println(p.xs.get(0u64).unwrap() + p.tag); // 17
    println(p.xs.len());           // 2

    // pop yields Option<*T>: unwrap to the slot pointer, deref for the value
    let popped: Option<*i32> = p.xs.pop();
    println(*popped.unwrap()); // 20
    println(p.xs.len()); // 1

    // no free: `Pair` owns through its `xs: Vec<i32>` field, so it is destroyed
    // - and the Vec's buffer released - when it goes out of scope here.
    return 0;
}
