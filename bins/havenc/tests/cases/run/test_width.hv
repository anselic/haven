// numerical_cast between the scalar widths. The printable conversions are
// value-checked (truncation direction, sign, round-trips must be exact); the
// unsigned / 64-bit destinations have no print_* and are exercised compile-only
// so their cast opcodes (zext / uitofp / fptoui) still get codegen coverage.

@export
proc main() i32 {
    // float -> int truncates toward zero (not floor): -2.7 -> -2, not -3
    println(numerical_cast::<i32>(3.9f64));   // 3
    println(numerical_cast::<i32>(-2.7f32));  // -2

    // int -> float
    println(numerical_cast::<f32>(5i32));   // 5.000000
    println(numerical_cast::<f64>(-3i32)); // -3.000000

    // widen then narrow, back to the start: i32 -> i64 -> i32
    println(numerical_cast::<i32>(numerical_cast::<i64>(7i32))); // 7

    // float narrow/widen round-trip: f32 -> f64 -> f32 (1.5 is exact in binary)
    println(numerical_cast::<f32>(numerical_cast::<f64>(1.5f32))); // 1.500000

    // i16 widen/narrow round-trip: i32 -> i16 -> i32 (value fits in i16)
    println(numerical_cast::<i32>(numerical_cast::<i16>(1000i32))); // 1000
    // i16 narrowing truncates to the low 16 bits: 70000 & 0xFFFF = 4464
    println(numerical_cast::<i32>(numerical_cast::<i16>(70000i32))); // 4464
    // i16 -> f32
    println(numerical_cast::<f32>(numerical_cast::<i16>(12i32))); // 12.000000

    // compile-only coverage for the casts that have no printer:
    // unsigned and 64-bit destinations (zext / uitofp / fptoui / fptrunc).
    let a: u32 = numerical_cast::<u32>(1i32);
    let b: u64 = numerical_cast::<u64>(2i64);
    let c: u32 = numerical_cast::<u32>(3.0f32);
    let d: u64 = numerical_cast::<u64>(4.0f64);
    let e: i64 = numerical_cast::<i64>(5u32);
    let f: f64 = numerical_cast::<f64>(6u64);
    // 16-bit destinations (trunc / zext / uitofp / fptoui) and 8<->16 widening.
    let g: u16 = numerical_cast::<u16>(7i32);
    let h: i32 = numerical_cast::<i32>(8u16);
    let i: u16 = numerical_cast::<u16>(9.0f32);
    let j: f32 = numerical_cast::<f32>(10u16);
    let k: i16 = numerical_cast::<i16>(11i8);
    let l: u16 = numerical_cast::<u16>(12u8);
    let m: i8  = numerical_cast::<i8>(13i16);

    return 0;
}
