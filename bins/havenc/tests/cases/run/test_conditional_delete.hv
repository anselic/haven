// A `where` clause makes `Delete` *conditional*, and conditional ownership is
// the point rather than a side effect.
//
// `extend Holder<T>: Delete where T: Delete` says a `Holder<Res>` owns something
// and a `Holder<i32>` does not. That distinction has to hold in two places at
// once: the instance's `Copy`-ness (a `Holder<i32>` may still be copied) and
// whether monomorphization mints a destructor for it at all - before this it
// minted one for *every* instance.
//
// std's own `Vec<T>: Delete` is *unconditional* (the allocation always needs
// freeing), so a `Vec<Res>` here is dropped by that impl - dropping its elements
// too - while the `Vec<u8>` inside `String` is left untouched. Both are exercised
// below to show the conditional `Holder` and the unconditional `Vec` compose.
//@ exit: 0

import std/string { String, string_from_str, string_as_str }
import std/vec { Vec, vec_new, vec_push, vec_len }

struct Res { id: i32 }

extend Res: Delete {
    proc delete(*self) { printf::<i32>("drop res %d\n", self.id); }
}

struct Holder<T> { item: T, tag: i32 }

extend Holder<T>: Delete where T: Delete {
    proc delete(*self) { printf::<i32>("drop holder %d\n", self.tag); }
}

@export
proc main() i32 {
    // the clause does not hold at `i32`, so this instance has no destructor and
    // stays `Copy` - the copy below would be a move error if it were covered.
    let plain: Holder<i32> = Holder::<i32> { item: 7, tag: 1 };
    let copied: Holder<i32> = plain;
    printf::<i32>("copied tag %d\n", copied.tag);

    // `String` holds a `Vec<u8>`; u8 owns nothing, so std's `Vec` destructor
    // frees the bytes without dropping any element, and the String is untouched
    // beyond that. Dropped automatically at end of scope.
    let s: String = string_from_str("hi");
    println(string_as_str(&s));

    // a std `Vec` of owners: unconditionally `Delete`, and `drop_in_place` runs
    // `Res::delete` for each of the two elements before the buffer is freed.
    let owned: Vec<Res> = vec_new::<Res>();
    vec_push::<Res>(&owned, Res { id: 10 });
    vec_push::<Res>(&owned, Res { id: 11 });
    printf::<u64>("owned %llu\n", vec_len::<Res>(&owned));

    // note the golden shows no "drop res 5": a `Holder<Res>` implements `Delete`
    // itself, so its `item` field is that method's business, not auto-dropped.
    let holder: Holder<Res> = Holder::<Res> { item: Res { id: 5 }, tag: 2 };
    printf::<i32>("holder tag %d\n", holder.tag);

    return 0;
}
