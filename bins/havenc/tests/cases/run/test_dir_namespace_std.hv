// The same directory-namespace rule over the *embedded* stdlib, which is walked
// by a separate implementation from on-disk modules (`include_dir` rather than
// `read_dir`) - so it gets its own fixture rather than riding on the user-module
// one.
//@ exit: 0

import std/dsp

@export
proc main() i32 {
    let o: dsp::osc::Osc = dsp::osc::osc_new(1.0, 4.0);
    // phase 0 -> square is +1.0
    let s: f32 = dsp::osc::osc_square(&o);
    if (s > 0.0) { return 0; }
    return 1;
}
