// A fixed-size array crossing a call boundary by value, in both directions.
//
// `[T; N]` is inline storage exactly as a struct is, but the ABI path in the
// backend was written as `Type::Named { def } if is_aggregate(def)` - keyed on a
// *definition*, which a structural type does not have. So an array parameter
// fell through to the scalar arm: the signature declared a raw `[N x T]` value
// while MIL handed the caller a pointer to storage, and LLVM's verifier rejected
// it. Returns failed the same way, at the `ret`. The wrapper case worked, which
// is the tell - `struct W { a: [f32; 3] }` has a `DefId`, so it took the
// aggregate path that the array itself was excluded from.
//
// The ladder below spans the classification boundaries, because the bug hides on
// either side of them: 4 and 8 bytes go Direct in one register, 12 and 16 in two,
// and anything larger goes Memory as a `byval` pointer. Aggregate elements are
// covered too, since their storage type is what the copy strides by.
//
// `mutate`/`keep` is the semantic half: by value means the callee gets its own
// copy, so writing through the parameter must not reach the caller's array. That
// is what makes `[T; N]` behave like the struct wrapping it rather than like a
// C array decaying to a pointer.
//@ exit: 0

struct G { k: f32 }
struct Big { a: f64, b: f64, c: f64 }   // 24 bytes - Memory class

proc small(a: [f32; 1]) f32 { return a[0u64]; }             // 4  - Direct, 1 reg
proc two(a: [f32; 2]) f32 { return a[0u64] + a[1u64]; }     // 8  - Direct, 1 reg
proc three(a: [f32; 3]) f32 { return a[0u64] + a[2u64]; }   // 12 - Direct, 2 regs
proc four(a: [f32; 4]) f32 { return a[0u64] + a[3u64]; }    // 16 - Direct, 2 regs
proc eight(a: [f32; 8]) f32 { return a[0u64] + a[7u64]; }   // 32 - Memory

proc structs(a: [G; 3]) f32 { return a[0u64].k + a[2u64].k; }
proc bigs(a: [Big; 2]) f64 { return a[0u64].a + a[1u64].c; }

/// by value means the callee owns its copy - this must not reach the caller
proc mutate(a: [f32; 3]) f32 { a[0u64] = 99.0; return a[0u64]; }

proc make3() [f32; 3] { return [2.0f32, 3.0f32, 4.0f32]; }
proc make_g() [G; 2] { return [G { k: 5.0 }, G { k: 6.0 }]; }
proc make_big() [Big; 2] {
    return [Big { a: 1.0, b: 0.0, c: 0.0 }, Big { a: 0.0, b: 0.0, c: 7.0 }];
}

/// a returned array feeding straight into a by-value parameter
proc roundtrip() f32 { return three(make3()); }

@export
proc main() i32 {
    println(small([7.0f32]));                                     // 7
    println(two([1.0f32, 2.0f32]));                               // 3
    println(three([1.0f32, 0.0f32, 2.0f32]));                     // 3
    println(four([1.0f32, 0.0f32, 0.0f32, 4.0f32]));              // 5
    println(eight([1.0f32, 0.0f32, 0.0f32, 0.0f32,
                   0.0f32, 0.0f32, 0.0f32, 8.0f32]));             // 9
    println(structs([G { k: 1.0 }, G { k: 0.0 }, G { k: 2.0 }])); // 3
    println(bigs([Big { a: 4.0, b: 0.0, c: 0.0 },
                  Big { a: 0.0, b: 0.0, c: 6.0 }]));              // 10

    let keep: [f32; 3] = [1.0f32, 2.0f32, 3.0f32];
    println(mutate(keep));                                        // 99
    println(keep[0u64]);                                          // 1, untouched

    let m: [f32; 3] = make3();
    println(m[0u64] + m[2u64]);                                   // 6
    let g: [G; 2] = make_g();
    println(g[0u64].k + g[1u64].k);                               // 11
    let b: [Big; 2] = make_big();
    println(b[0u64].a + b[1u64].c);                               // 8
    println(roundtrip());                                         // 6
    return 0;
}
