// `std/math` on scalars and vectors: each function is an LLVM intrinsic, so the
// values below are LLVM's documented results, edge cases included.

import std/math
import std/math { Float, sqrt, clamp }
import std/numeric/f32
import std/simd { simd_splat, simd_store }

// a bound on a caller's own generic code, satisfied by every float type
proc magnitude<T: Float>(x: T) T { return sqrt(math::abs(x)); }

@export
proc main() i32 {
    let nan = f32::from_bits(0x7fc00000u32);

    println(sqrt(16.0f32));                       // 4
    println(sqrt(2.25));                          // 1.5, an untyped literal is f64
    println(math::abs(-3.5f32));                  // 3.5
    println(math::copysign(2.0f32, -0.0f32));     // -2, the sign of a zero counts
    println(math::min(nan, 1.0f32));              // 1, NaN never wins
    println(math::max(2.0f64, 5.0f64));           // 5
    println(clamp(7.0f32, -1.0f32, 1.0f32));      // 1
    println(clamp(nan, -1.0f32, 1.0f32));         // -1, NaN clamps to `lo`
    println(math::fma(2.0f64, 3.0f64, 1.0f64));   // 7
    println(math::mul_add(2.0f32, 3.0f32, 1.0f32)); // 7

    println(math::floor(-1.5f32));                // -2
    println(math::ceil(-1.5f32));                 // -1
    println(math::trunc(-1.7f32));                // -1
    println(math::round(2.5f32));                 // 3, away from zero
    println(math::round(-2.5f32));                // -3
    println(math::round_even(2.5f32));            // 2, to even
    println(math::round_even(3.5f32));            // 4

    println(math::sin(0.0f32));                   // 0
    println(math::cos(0.0f64));                   // 1
    println(math::exp(0.0f32));                   // 1
    println(math::exp2(10.0f32));                 // 1024
    println(math::log(1.0f64));                   // 0
    println(math::log2(8.0f32));                  // 3
    println(math::log10(1000.0f64));              // 3
    println(math::pow(2.0f32, 10.0f32));          // 1024
    println(magnitude(-4.0f32));                  // 2

    // libm bindings for what has no intrinsic, f64 and f32
    println(math::tan(0.0));                      // 0
    println(math::asinf(1.0f32) * 2.0f32);        // pi
    println(math::cbrtf(27.0f32));                // 3

    // the same functions, lane by lane
    let out: [f32] = [0.0f32; 4];
    simd_store::<f32, 4>(out, 0u64, sqrt(simd_splat::<f32, 4>(9.0f32)));
    println(out[2]);                              // 3
    let lo = simd_splat::<f32, 4>(-1.0f32);
    let hi = simd_splat::<f32, 4>(1.0f32);
    simd_store::<f32, 4>(out, 0u64, clamp(simd_splat::<f32, 4>(3.0f32), lo, hi));
    println(out[0]);                              // 1
    simd_store::<f32, 4>(out, 0u64, math::sin(simd_splat::<f32, 4>(0.0f32)));
    println(out[1]);                              // 0
    simd_store::<f32, 4>(out, 0u64, magnitude(simd_splat::<f32, 4>(-16.0f32)));
    println(out[3]);                              // 4
    return 0;
}
