// A sequence of aggregates is contiguous inline storage, and indexing one yields
// a pointer to the i-th inline element - the same convention field access and
// dereference already follow, where an aggregate value *is* its address.
//
// This is one representation for three bases: a stack `[T; N]`, a `[T]` slice,
// and a raw `*T` heap buffer all lay their struct elements out as `[.. x %Name]`
// (what `size_of` and `alloc::<T>` already assume), stride by the real element,
// and hand back an element pointer rather than loading a machine word. Before
// this, arrays boxed their struct elements as `[N x ptr]` handles while `alloc`
// laid them out inline, so a `*T` walked with the wrong stride: `buf[i].field`
// read a neighbour's bytes, or segfaulted.
//@ exit: 0

import std/alloc { realloc, dealloc }

// wider than a pointer, so a word-sized stride would overlap elements
struct V3 { x: i32, y: i32, z: i32 }

proc sum(v: V3) i32 { return v.x + v.y + v.z; }

@export
proc main() i32 {
    // --- stack array of structs
    let arr: [V3; 3] = [
        V3 { x: 1, y: 2, z: 3 },
        V3 { x: 4, y: 5, z: 6 },
        V3 { x: 7, y: 8, z: 9 },
    ];
    print("arr "); print(arr[0].x);
    print(" "); print(arr[1].y);
    print(" "); println(arr[2].z);

    // value semantics: a copy out of the array does not alias it
    let c: V3 = arr[1];
    c.x = 99;
    print("copy "); print(c.x);
    print(" orig "); println(arr[1].x);

    // an element passed by value
    print("sum "); println(sum(arr[2]));

    // --- a pointer into that stack array, then walked as a buffer: the element
    // stride and the field offsets must agree with the array's own layout.
    let q: *V3 = &arr[0];
    print("q0 "); print(q[0].x);
    print(" q1 "); print(q[1].x);
    print(" q2 "); println(q[2].x);
    // a bare element pointer, no index: reads inline fields directly
    print("qdirect "); println(q.y);

    // --- a slice over the same storage
    let s: [V3] = arr;
    print("slice "); print(s[1].x);
    print(" "); println(s[2].y);

    // --- a raw heap buffer: inline elements, same as the stack ones
    let buf: *V3 = realloc::<V3>(null::<*V3>(), 4u64).unwrap();
    let i: u64 = 0u64;
    while (i < 4u64) {
        let n: i32 = numerical_cast::<i32>(i);
        buf[i] = V3 { x: n, y: n * 10, z: n * 100 };
        i = i + 1u64;
    }
    print("buf "); print(buf[0].x);
    print(" "); print(buf[3].y);
    print(" "); println(buf[3].z);
    // write through an index, then read back
    buf[2].y = 777;
    print("wrote "); println(buf[2].y);
    dealloc::<V3>(buf);

    // --- write through a stack-array index too
    arr[0].x = 42;
    print("arr wrote "); println(arr[0].x);
    return 0;
}
