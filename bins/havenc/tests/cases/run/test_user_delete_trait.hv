// A program's own `trait Delete` is an ordinary trait.
//
// The destructor trait is identified by the `@lang(delete)` the stdlib marks it
// with, not by its name and not by the module it is declared in. So the name is
// free: declaring one here shadows the prelude's in this module's scope and
// still means nothing to the compiler.
//
// So `Token` keeps every non-owner property: it stays `Copy` (the call below
// does not move it, and it is still readable afterwards), nothing synthesizes a
// destructor call for it, and its `delete` is an ordinary method that may be
// called by hand - which for a real owner is an error, see
// `fail/test_delete_explicit.hv`. One `explicit` in the output, not two.

trait Delete {
    proc delete(*self);
}

struct Token {
    id: i32,
}

extend Token: Delete {
    proc delete(*self) {
        println("explicit");
    }
}

@export
proc main() i32 {
    let t: Token = Token { id: 7 };
    t.delete();
    println(t.id);
    return 0;
}
