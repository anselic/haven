// A tiny post-build driver, the kind of thing you'd run after `havenc` emits a
// binary: stage the artifact into a `dist/` directory, drop a version stamp
// beside it, and report what happened. It leans entirely on std/fs.
//
// std/fs is fallible-by-Result: each call returns `Ok(value)` or `Err(FsError)`,
// and an `FsError` can tell you its `message()`. This driver treats "already
// exists" as fine for the output dir and bails out loudly on anything else.

import std/fs
import std/result { Result }
import std/string { String }

// Copy `src` -> `dst`, printing the outcome. Returns false on failure so `main`
// can stop early.
proc stage(src: str, dst: str) bool {
    match (fs::copy(src, dst)) {
        Result::Ok(n) -> {
            printf::<i32>("  staged (%d bytes)\n", numerical_cast::<i32>(n));
            return true;
        }
        Result::Err(e) -> {
            printf::<str>("  copy failed: %s\n", e.message());
            return false;
        }
    }
}

@export
proc main() i32 {
    let outdir: str = "dist";
    let artifact: str = "output.exe";     // whatever the build just produced
    let staged: str = "dist/output.exe";

    // ensure the output directory exists; a pre-existing one is not an error.
    if (!fs::is_dir(outdir)) {
        match (fs::mkdir(outdir)) {
            Result::Ok(_)  -> { println("created dist/"); }
            Result::Err(e) -> { printf::<str>("mkdir failed: %s\n", e.message()); return 1; }
        }
    }

    // only stage if the build actually produced the artifact.
    if (!fs::exists(artifact)) {
        printf::<str>("nothing to stage: %s missing\n", artifact);
        return 1;
    }

    println("staging artifact:");
    if (!stage(artifact, staged)) { return 1; }

    // write a version stamp next to it.
    let stamp: String = String::from_str("build 1\n");
    match (fs::write("dist/VERSION", &stamp)) {
        Result::Ok(_)  -> { println("wrote dist/VERSION"); }
        Result::Err(e) -> { printf::<str>("stamp failed: %s\n", e.message()); return 1; }
    }

    println("done.");
    return 0;
}
