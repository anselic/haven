// A complete CLAP plugin written against the std/plug framework: a stereo gain
// with one automatable parameter. Compare examples/3_clap.hv, which wires the
// same plugin against the raw CLAP bindings by hand — this version writes only
// the state, the trait impl, and one exported const; std/plug builds every piece
// of ABI glue generically from the `Gain` type.
//
//     havenc examples/4_gain_plug.hv -o Gain --shared
//     # then rename Gain.dll -> Gain.clap and load it in a CLAP host

import std/clap/version { ClapVersion }
import std/clap/process { ClapProcess, ClapProcessStatus, ClapAudioBuffer }
import std/clap/plugin { ClapPluginEntry }
import std/plug {
    Plugin, FloatParam,
    plug_entry_init, plug_entry_deinit, plug_entry_get_factory,
}

// The plugin's state — just data. No ABI types, no vtables.
struct Gain {
    gain: f64,
    sample_rate: f64,
}

extend Gain: Plugin {
    // --- metadata + static descriptors (associated, no self) ---
    proc id() str { return "com.haven.gain"; }
    proc name() str { return "Haven Gain"; }
    proc vendor() str { return "Haven"; }
    proc version() str { return "1.0.0"; }
    proc category() str { return "audio-effect"; }
    proc channels() u32 { return 2u32; }
    proc param_count() u32 { return 1u32; }
    proc param(index: u32) FloatParam {
        return FloatParam::new(0u32, "Gain", 0.0f64, 2.0f64, 1.0f64);
    }
    // construct fresh state (the return is spelled `Gain`, not `Self`, since
    // `Self` in a method body isn't substituted yet).
    proc new() Gain {
        return Gain { gain: 1.0f64, sample_rate: 44100.0f64 };
    }

    // --- live state (self) ---
    proc activate(*self, sample_rate: f64) {
        self.sample_rate = sample_rate;
    }
    proc param_get(*self, id: u32) f64 { return self.gain; }
    proc param_set(*self, id: u32, value: f64) { self.gain = value; }

    // --- audio: out[ch][i] = in[ch][i] * gain ---
    proc process(*self, ctx: *ClapProcess) ClapProcessStatus {
        let g: f64 = self.gain;
        let frames: u32 = ctx.frames_count;
        let outs: *ClapAudioBuffer = ctx.audio_outputs;
        let ins: *ClapAudioBuffer = ctx.audio_inputs;
        let channels: u32 = outs.channel_count;
        let ch: u32 = 0u32;
        while (ch < channels) {
            let src: *f32 = ins.data32[ch];
            let dst: *f32 = outs.data32[ch];
            let i: u32 = 0u32;
            while (i < frames) {
                dst[i] = numerical_cast::<f32>(numerical_cast::<f64>(src[i]) * g);
                i = i + 1u32;
            }
            ch = ch + 1u32;
        }
        return ClapProcessStatus::Continue;
    }
}

// The one symbol a `.clap` exports. Its three callbacks are framework generics
// instantiated at `Gain`; everything downstream is monomorphized from them.
@export const clap_entry: ClapPluginEntry = ClapPluginEntry {
    clap_version: ClapVersion { major: 1u32, minor: 2u32, revision: 2u32 },
    init: plug_entry_init::<Gain>,
    deinit: plug_entry_deinit::<Gain>,
    get_factory: plug_entry_get_factory::<Gain>,
};
