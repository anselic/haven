struct LowPass {
    previous: f32,

    @alloc(false)
    proc process(*self, input: f32, cutoff: f32) f32 {
        self.previous = self.previous + cutoff * (input - self.previous);
        return self.previous;
    }
}

proc main() i32 {
    let filter = LowPass { previous: 0.0 };
    println(filter.process(1.0, 0.2));
    return 0;
}